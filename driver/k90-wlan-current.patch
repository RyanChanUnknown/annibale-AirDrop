+qdf_nbuf_t dp_tx_send_passthru(struct cdp_soc_t *soc_hdl, uint8_t vdev_id,
+			     qdf_nbuf_t nbuf)
+{
+	return dp_tx_send_passthru_internal(soc_hdl, vdev_id, nbuf, NULL, NULL);
