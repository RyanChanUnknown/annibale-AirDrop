+	}
 
 	lim_message_processor(mac_ctx, msg);
 
@@ -5169,3 +5184,168 @@ void lim_update_vdev_sr_elements(struct pe_session *session_entry,
 
 }
 #endif
+
+#ifdef DRIVER_PASSTHRU_SESSION
+void lim_passthrough_init_session(struct mac_context *mac,
+				 struct sir_create_session *msg)
+{
+	struct pe_session *session;
+	struct wlan_objmgr_vdev *vdev;
+	uint8_t session_id;
+	QDF_STATUS status;
+
+	if (!msg)
+		return;
+	vdev = wlan_objmgr_get_vdev_by_id_from_psoc(mac->psoc, msg->vdev_id,
+						  WLAN_LEGACY_MAC_ID);
+	if (!vdev) {
+		status = QDF_STATUS_E_INVAL;
+	} else if (wlan_vdev_mlme_get_opmode(vdev) != QDF_PASSTHRU_MODE) {
+		status = QDF_STATUS_E_INVAL;
+	} else if (pe_find_session_by_vdev_id(mac, msg->vdev_id)) {
+		status = QDF_STATUS_E_BUSY;
+	} else {
+		session = pe_create_session(mac, msg->bss_id.bytes, &session_id,
+				mac->lim.max_sta_of_pe_session, eSIR_PASSTHRU_MODE,
+				msg->vdev_id);
+		status = session ? QDF_STATUS_SUCCESS : QDF_STATUS_E_FAILURE;
+	}
+	if (vdev)
+		wlan_objmgr_vdev_release_ref(vdev, WLAN_LEGACY_MAC_ID);
+	sme_post_passthrough_event(msg->vdev_id, SIR_PASSTHRU_PE_CREATED,
+				   status);
+}
+
+void lim_passthrough_deinit_session(struct mac_context *mac,
+				   struct sir_delete_session *msg)
+{
+	struct pe_session *session;
+	QDF_STATUS status = QDF_STATUS_E_INVAL;
+
+	if (!msg)
+		return;
+	session = pe_find_session_by_vdev_id(mac, msg->vdev_id);
+	if (session && LIM_IS_PASSTHRU_ROLE(session)) {
+		status = wlan_vdev_mlme_sm_deliver_evt(session->vdev,
+					WLAN_VDEV_SM_EV_DOWN, 0, NULL);
+		if (QDF_IS_STATUS_SUCCESS(status))
+			pe_delete_session(mac, session);
+	}
+	/* Reports only local PE deletion; STOP/DOWN events are separate. */
+	sme_post_passthrough_event(msg->vdev_id, SIR_PASSTHRU_PE_DELETED,
+				   status);
+}
+#endif
+
+
+#ifdef DRIVER_PASSTHRU_OWNER
+void lim_process_passthru_request(struct mac_context *mac,
+		struct scheduler_msg *msg)
+{
+	struct sme_passthru_request *request = msg->bodyptr;
+	const struct sme_passthru_request_input *input;
+	struct wlan_objmgr_vdev *current_vdev = NULL;
+	struct pe_session *session;
+	enum sme_passthru_session_state state = SME_PASSTHRU_SESSION_UNKNOWN;
+	QDF_STATUS status = QDF_STATUS_E_INVAL;
+	bool changed = false;
+	uint8_t session_id;
+	uint8_t bssid[6];
+
+	if (!request)
+		return;
+	if (!sme_passthru_request_begin(request))
+		goto dispose;
+	input = sme_passthru_request_input(request);
+	if (!mac || mac->psoc != input->psoc ||
+	    (msg->type == eWNI_SME_PASSTHRU_CREATE_REQUEST) !=
+		(input->action == SME_PASSTHRU_REQUEST_CREATE))
+		goto finish;
+	current_vdev = wlan_objmgr_get_vdev_by_id_from_psoc(mac->psoc,
+					input->vdev_id, WLAN_LEGACY_MAC_ID);
+	if (current_vdev != input->vdev ||
+	    wlan_vdev_mlme_get_opmode(current_vdev) != QDF_PASSTHRU_MODE)
+		goto finish;
+	session = pe_find_session_by_vdev_id(mac, input->vdev_id);
+	if (session && (session->vdev != input->vdev ||
+			!LIM_IS_PASSTHRU_ROLE(session)))
+		goto finish;
+	state = session ? SME_PASSTHRU_SESSION_PRESENT :
+		SME_PASSTHRU_SESSION_ABSENT;
+	if (input->action == SME_PASSTHRU_REQUEST_CREATE) {
+		if (session) {
+			status = QDF_STATUS_E_BUSY;
+		} else {
+			qdf_mem_copy(bssid, input->bssid, sizeof(bssid));
+			session = pe_create_session(mac, bssid, &session_id,
+					mac->lim.max_sta_of_pe_session,
+					eSIR_PASSTHRU_MODE, input->vdev_id);
+			status = session ? QDF_STATUS_SUCCESS : QDF_STATUS_E_FAILURE;
+			if (session && (session->vdev != input->vdev ||
+					!LIM_IS_PASSTHRU_ROLE(session))) {
+				/* pe_create_session obtains its own ID lookup/ref. */
+				pe_delete_session(mac, session);
+				status = QDF_STATUS_E_INVAL;
+				state = SME_PASSTHRU_SESSION_UNKNOWN;
+			} else if (session) {
+				state = SME_PASSTHRU_SESSION_PRESENT;
+				changed = true;
+			}
+		}
+	} else if (!session) {
+		status = QDF_STATUS_E_NOENT;
+	} else {
+		status = wlan_vdev_mlme_sm_deliver_evt(session->vdev,
+					WLAN_VDEV_SM_EV_DOWN, 0, NULL);
+		if (QDF_IS_STATUS_SUCCESS(status)) {
+			pe_delete_session(mac, session);
+			state = SME_PASSTHRU_SESSION_ABSENT;
+			changed = true;
+		}
+	}
+finish:
+	if (current_vdev)
+		wlan_objmgr_vdev_release_ref(current_vdev, WLAN_LEGACY_MAC_ID);
