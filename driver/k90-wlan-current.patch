+	bool has_bw;
+	bool has_mcs;
+	bool has_sgi;
+	bool has_ldpc;
+	bool has_ht_bw40;
+	bool has_ht_sgi20;
+	bool has_ht_sgi40;
+	bool has_ht_ldpc;
+	bool has_vht_sgi80;
+	bool has_vht_ldpc;
+	bool has_max_mpdu;
+	bool has_ampdu_exp;
+	bool has_mpdu_density;
+	bool has_ht_mcs;
+	bool cap_ht;
+	bool cap_vht;
+	u8 cap_nss;
+	u8 cap_bw;
+	u8 cap_mcs;
+	bool cap_sgi;
