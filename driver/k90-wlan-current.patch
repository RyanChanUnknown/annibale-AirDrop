+/*
+ * No peer implies no reliable vdev mapping here. Only a unique PASSTHRU
+ * endpoint on this pdev is eligible; ambiguous endpoints consume/drop.
+ * Non-raw buffers and complete inactive chains use legacy cleanup, which
+ * excludes PASSTHRU endpoints from its unguarded control callback.
+ */
+static bool
+dp_rx_passthru_invalid_peer(struct dp_soc *soc, qdf_nbuf_t list,
+			   bool mpdu_done, uint8_t mac_id)
+{
+	struct dp_pdev *pdev = dp_get_pdev_for_lmac_id(soc, mac_id);
+	struct dp_vdev *vdev, *held = NULL;
+	qdf_nbuf_t nbuf, next;
+	uint32_t prefix, pad, linear_len;
+	bool found = false, ambiguous = false;
+	bool unsupported_chain = list && qdf_nbuf_next(list);
+
+	if (!pdev)
+		return false;
+	if (!list || qdf_nbuf_is_nonlinear(list) ||
+	    !hal_rx_passthru_tlv_size_valid(soc->hal_soc, soc->rx_pkt_tlv_size) ||
+	    qdf_nbuf_headlen(list) < soc->rx_pkt_tlv_size ||
+	    !HAL_IS_DECAP_FORMAT_RAW(soc->hal_soc, qdf_nbuf_data(list)))
+		return false;
+	qdf_spin_lock_bh(&pdev->vdev_list_lock);
+	DP_PDEV_ITERATE_VDEV_LIST(pdev, vdev) {
+		if (vdev->opmode != wlan_op_mode_passthru)
+			continue;
+		if (found) {
+			ambiguous = true;
+			break;
+		}
+		found = true;
+		if (!QDF_IS_STATUS_ERROR(dp_vdev_get_ref(soc, vdev,
+							 DP_MOD_ID_RX_ERR)))
+			held = vdev;
+	}
+	qdf_spin_unlock_bh(&pdev->vdev_list_lock);
+	if (!found)
+		return false;
+	/* Preserve the producer's partial chain even after admission closes. */
+	if (!mpdu_done) {
+		if (held)
+			dp_vdev_unref_delete(soc, held, DP_MOD_ID_RX_ERR);
+		return true;
+	}
+	if (!held || !dp_passthru_enter(held)) {
+		if (held)
+			dp_vdev_unref_delete(soc, held, DP_MOD_ID_RX_ERR);
+		return false;
+	}
+
+	/* Detach the producer's list before any OSIF ownership transfer. */
+	pdev->invalid_peer_head_msdu = NULL;
+	pdev->invalid_peer_tail_msdu = NULL;
+	for (nbuf = list; nbuf; nbuf = next) {
+		next = qdf_nbuf_next(nbuf);
+		qdf_nbuf_set_next(nbuf, NULL);
+		if (!held || ambiguous || unsupported_chain ||
+		    qdf_nbuf_is_nonlinear(nbuf) ||
+		    qdf_nbuf_is_frag(nbuf) || qdf_nbuf_is_rx_chfrag_cont(nbuf))
+			goto drop;
+		linear_len = qdf_nbuf_headlen(nbuf);
+		if (!hal_rx_passthru_tlv_size_valid(soc->hal_soc,
+						   soc->rx_pkt_tlv_size) ||
+		    linear_len < soc->rx_pkt_tlv_size)
+			goto drop;
+		pad = hal_rx_msdu_end_l3_hdr_padding_get(soc->hal_soc,
+							qdf_nbuf_data(nbuf));
+		prefix = soc->rx_pkt_tlv_size + pad;
+		if (prefix > linear_len || linear_len - prefix < 10)
+			goto drop;
+		dp_rx_skip_tlvs(soc, nbuf, pad);
+		if (!QDF_IS_STATUS_ERROR(
+				dp_rx_deliver_raw_passthru(soc, held, nbuf)))
+			continue;
+drop:
+		dp_rx_nbuf_free(nbuf);
+	}
+	dp_passthru_exit(held);
+	dp_vdev_unref_delete(soc, held, DP_MOD_ID_RX_ERR);
+	return true;
+}
+#endif /* !RX_PEER_INVALID_ENH */
