+#ifdef DRIVER_PASSTHRU_SESSION
+static QDF_STATUS wma_passthru_up_send(struct vdev_mlme_obj *mlme)
+{
+	struct wlan_objmgr_vdev *vdev = mlme->vdev;
+	uint32_t cookie = 0;
+	QDF_STATUS status;
+
+	wlan_vdev_obj_lock(vdev);
+	status = wlan_pt_txn_up_begin(&mlme->passthru_txn, &cookie);
+	wlan_vdev_obj_unlock(vdev);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status; /* No accepted START, or already closed/consumed. */
+	mlme->proto.sta.assoc_id = 0;
+	status = cds_get_context(QDF_MODULE_ID_WMA) ?
+		vdev_mgr_up_send(mlme) : QDF_STATUS_E_INVAL;
+	wlan_vdev_obj_lock(vdev);
+	status = wlan_pt_txn_up_end(&mlme->passthru_txn, cookie, status);
+	wlan_vdev_obj_unlock(vdev);
+	/* Reports the actual UP submission, still NOT a firmware UP ACK. */
+	sme_post_passthrough_channel_event(wlan_vdev_get_id(vdev),
+				SIR_PASSTHRU_UP_SUBMITTED, status, cookie);
+	return status;
+}
+#endif
