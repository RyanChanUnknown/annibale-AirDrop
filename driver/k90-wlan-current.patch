@@ -6443,6 +6443,56 @@ unsigned int qdf_nbuf_update_radiotap(struct mon_rx_status *rx_status,
 #endif
 qdf_export_symbol(qdf_nbuf_update_radiotap);
 
+#ifdef DRIVER_PASSTHRU_DP
+/* Optional measured kiwi_v2 RX metadata. Legacy framing remains the default.
+ * Only the explicit experimental caller supplies the normalized timestamp and
+ * signed signal. This kiwi_v2 path retains the four-byte 802.11 FCS.
+ * Do not invent rate, antenna or noise floor.
+ * Failure leaves the skb unchanged; success returns the actual added length.
+ */
+unsigned int qdf_nbuf_update_radiotap_passthru(qdf_nbuf_t nbuf,
+                                             uint16_t freq, bool fcs_error,
+                                             bool metadata, uint64_t tsft_us,
+                                             int8_t signal_dbm)
+{
+    uint8_t hdr[23] = {0};
+    unsigned int len = metadata ? 23 : 14;
+    unsigned int flags_offset = metadata ? 16 : 8;
+    uint16_t chan_flags = 0;
+    uint32_t present = (1U << IEEE80211_RADIOTAP_FLAGS) |
+                      (1U << IEEE80211_RADIOTAP_CHANNEL);
+    uint8_t *data;
+
+    if (!nbuf || !freq || skb_cloned(nbuf) || skb_shared(nbuf) ||
+        skb_headroom(nbuf) < len ||
+        (metadata && (!tsft_us || signal_dbm >= 0 || signal_dbm == -128)))
+        return 0;
+    if (freq >= 2400 && freq <= 2500)
+        chan_flags = 0x0080;
+    else if (freq >= 4900 && freq < 5925)
+        chan_flags = 0x0100;
+    if (metadata) {
+        present |= (1U << IEEE80211_RADIOTAP_TSFT) |
+                   (1U << IEEE80211_RADIOTAP_DBM_ANTSIGNAL);
+        put_unaligned_le64(tsft_us, hdr + 8);
+        hdr[22] = (uint8_t)signal_dbm;
+    }
+    put_unaligned_le16(len, hdr + 2);
+    put_unaligned_le32(present, hdr + 4);
+    hdr[flags_offset] = fcs_error ? IEEE80211_RADIOTAP_F_BADFCS : 0;
+    if (metadata)
+        hdr[flags_offset] |= IEEE80211_RADIOTAP_F_FCS;
+    put_unaligned_le16(freq, hdr + flags_offset + 2);
+    put_unaligned_le16(chan_flags, hdr + flags_offset + 4);
+    data = qdf_nbuf_push_head(nbuf, len);
+    if (!data)
+        return 0;
+    qdf_mem_copy(data, hdr, len);
+    return len;
+}
+#endif /* DRIVER_PASSTHRU_DP */
