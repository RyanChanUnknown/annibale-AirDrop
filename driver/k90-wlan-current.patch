index 0000000000000000000000000000000000000000..5705289e6956125acdce0e0f20af4b3741ad592a
--- /dev/null
+++ b/qca-wifi-host-cmn/dp/wifi3.0/dp_pt_rate_observer.h
@@ -0,0 +1,224 @@
+/* SPDX-License-Identifier: ISC */
+#ifndef DP_PT_RATE_OBSERVER_H
+#define DP_PT_RATE_OBSERVER_H
+#ifdef DRIVER_PASSTHRU_DP
+#include <linux/cache.h>
+#include <linux/irqflags.h>
+#include <linux/moduleparam.h>
+#include <linux/smp.h>
+#include <linux/threads.h>
+#ifdef DRIVER_PASSTHRU_OWNER
+#include <qdf_pt_remote_peer.h>
+#endif
+static bool pt_single_ring;
+module_param(pt_single_ring, bool, 0444);
+static bool pt_rate_observe;
+module_param(pt_rate_observe, bool, 0644);
+struct pt_rate_counts {
+ u64 completed, valid, invalid, tries, amsdu, ldpc;
+ u64 ppdus, agg_ppdus, agg_mpdus, ast_overrides, remote_peer_compl;
+ u64 bw[8], mcs[16], pkt[16], gi[4], status[17], tx_ring[8], ppdu_bin[6];
+ bool have_ppdu;
+ u32 last_ppdu_id;
+ u16 last_ppdu_peer_id;
+ u32 cur_ppdu_cnt;
+ u32 max_ppdu_mpdus;
+ u16 last_peer_id;
+};
+struct pt_rate_cpu_slot {
+ struct pt_rate_counts c;
+} ____cacheline_aligned_in_smp;
+static struct pt_rate_cpu_slot pt_rates_cpu[NR_CPUS];
+static u16 pt_last_peer_id = U16_MAX;
+
+static void dp_pt_ring_begin(unsigned int ring)
+{
+ unsigned long flags;
+ unsigned int cpu;
+
+ if (!READ_ONCE(pt_rate_observe) || ring >= 8)
+  return;
+ local_irq_save(flags);
+ cpu = smp_processor_id();
+ if (likely(cpu < ARRAY_SIZE(pt_rates_cpu))) {
+  struct pt_rate_counts *r = &pt_rates_cpu[cpu].c;
+  WRITE_ONCE(r->tx_ring[ring], r->tx_ring[ring] + 1);
+ }
+ local_irq_restore(flags);
+}
+
+static inline void dp_pt_ast_override_inc(void)
+{
+ unsigned long flags;
+ unsigned int cpu;
+
+ if (!READ_ONCE(pt_rate_observe))
+  return;
+ local_irq_save(flags);
+ cpu = smp_processor_id();
+ if (likely(cpu < ARRAY_SIZE(pt_rates_cpu))) {
+  struct pt_rate_counts *r = &pt_rates_cpu[cpu].c;
+  WRITE_ONCE(r->ast_overrides, r->ast_overrides + 1);
+ }
+ local_irq_restore(flags);
+}
+
+static inline unsigned int dp_pt_ppdu_bucket(u32 cnt)
+{
+ if (cnt <= 1)
+  return 0;
+ if (cnt <= 3)
+  return 1;
+ if (cnt <= 7)
+  return 2;
+ if (cnt <= 15)
+  return 3;
+ if (cnt <= 31)
+  return 4;
+ return 5;
+}
+
+/* Only called with a parsed TQM completion, before descriptor recycling.
+ * Does not change status, peer ownership, queueing or callbacks.
+ */
+static void dp_pt_rate_end(const struct hal_tx_completion_status *ts)
+{
+ unsigned long flags;
+ unsigned int cpu;
+ bool remote_active = false;
+
+ if (!READ_ONCE(pt_rate_observe) || !ts)
+  return;
+#ifdef DRIVER_PASSTHRU_OWNER
+ remote_active = pt_remote_peer_is_active_id(ts->peer_id);
+#endif
+ local_irq_save(flags);
+ cpu = smp_processor_id();
+ if (likely(cpu < ARRAY_SIZE(pt_rates_cpu))) {
+  struct pt_rate_counts *r = &pt_rates_cpu[cpu].c;
+  WRITE_ONCE(r->completed, r->completed + 1);
+  WRITE_ONCE(r->tries, r->tries + ts->transmit_cnt);
+  {
+   unsigned int st = ts->status < 16 ? ts->status : 16;
+   WRITE_ONCE(r->status[st], r->status[st] + 1);
+  }
+  WRITE_ONCE(pt_last_peer_id, ts->peer_id);
+  if (remote_active)
+   WRITE_ONCE(r->remote_peer_compl, r->remote_peer_compl + 1);
+  if (ts->valid) {
+   WRITE_ONCE(r->valid, r->valid + 1);
+   if (likely(ts->bw < 8))
+    WRITE_ONCE(r->bw[ts->bw], r->bw[ts->bw] + 1);
+   if (likely(ts->mcs < 16))
+    WRITE_ONCE(r->mcs[ts->mcs], r->mcs[ts->mcs] + 1);
+   if (likely(ts->pkt_type < 16))
+    WRITE_ONCE(r->pkt[ts->pkt_type], r->pkt[ts->pkt_type] + 1);
+   if (likely(ts->sgi < 4))
+    WRITE_ONCE(r->gi[ts->sgi], r->gi[ts->sgi] + 1);
+   if (ts->msdu_part_of_amsdu)
+    WRITE_ONCE(r->amsdu, r->amsdu + 1);
+   if (ts->ldpc)
+    WRITE_ONCE(r->ldpc, r->ldpc + 1);
+   if (!r->have_ppdu || ts->ppdu_id != r->last_ppdu_id ||
+       ts->peer_id != r->last_ppdu_peer_id) {
+    if (r->have_ppdu) {
+     unsigned int b = dp_pt_ppdu_bucket(r->cur_ppdu_cnt);
+     WRITE_ONCE(r->ppdu_bin[b], r->ppdu_bin[b] + 1);
+    }
+    r->have_ppdu = true;
+    r->last_ppdu_id = ts->ppdu_id;
+    r->last_ppdu_peer_id = ts->peer_id;
+    r->cur_ppdu_cnt = 1;
+    WRITE_ONCE(r->ppdus, r->ppdus + 1);
+    if (r->max_ppdu_mpdus < 1)
+     WRITE_ONCE(r->max_ppdu_mpdus, 1);
+   } else {
+    r->cur_ppdu_cnt++;
+    if (r->cur_ppdu_cnt == 2) {
+     WRITE_ONCE(r->agg_ppdus, r->agg_ppdus + 1);
+     WRITE_ONCE(r->agg_mpdus, r->agg_mpdus + 2);
+    } else {
+     WRITE_ONCE(r->agg_mpdus, r->agg_mpdus + 1);
+    }
+    if (r->cur_ppdu_cnt > r->max_ppdu_mpdus)
+     WRITE_ONCE(r->max_ppdu_mpdus, r->cur_ppdu_cnt);
+   }
+  } else {
+   WRITE_ONCE(r->invalid, r->invalid + 1);
+  }
+ }
+ local_irq_restore(flags);
+}
+
+static void dp_pt_rate_aggregate(struct pt_rate_counts *s)
+{
+ unsigned int cpu, i;
+
+ memset(s, 0, sizeof(*s));
+ for (cpu = 0; cpu < ARRAY_SIZE(pt_rates_cpu); cpu++) {
+  const struct pt_rate_counts *r = &pt_rates_cpu[cpu].c;
+  u32 peak;
+
+  s->completed += READ_ONCE(r->completed);
+  s->valid += READ_ONCE(r->valid);
+  s->invalid += READ_ONCE(r->invalid);
+  s->tries += READ_ONCE(r->tries);
+  s->amsdu += READ_ONCE(r->amsdu);
+  s->ldpc += READ_ONCE(r->ldpc);
+  s->ppdus += READ_ONCE(r->ppdus);
+  s->agg_ppdus += READ_ONCE(r->agg_ppdus);
+  s->agg_mpdus += READ_ONCE(r->agg_mpdus);
+  s->ast_overrides += READ_ONCE(r->ast_overrides);
+  s->remote_peer_compl += READ_ONCE(r->remote_peer_compl);
+  for (i = 0; i < 8; i++)
+   s->bw[i] += READ_ONCE(r->bw[i]);
+  for (i = 0; i < 16; i++)
+   s->mcs[i] += READ_ONCE(r->mcs[i]);
+  for (i = 0; i < 16; i++)
+   s->pkt[i] += READ_ONCE(r->pkt[i]);
+  for (i = 0; i < 4; i++)
+   s->gi[i] += READ_ONCE(r->gi[i]);
+  for (i = 0; i < 17; i++)
+   s->status[i] += READ_ONCE(r->status[i]);
+  for (i = 0; i < 8; i++)
+   s->tx_ring[i] += READ_ONCE(r->tx_ring[i]);
+  for (i = 0; i < 6; i++)
+   s->ppdu_bin[i] += READ_ONCE(r->ppdu_bin[i]);
+  peak = READ_ONCE(r->max_ppdu_mpdus);
+  if (peak > s->max_ppdu_mpdus)
+   s->max_ppdu_mpdus = peak;
+ }
+ s->last_peer_id = READ_ONCE(pt_last_peer_id);
+}
+
+static int dp_pt_rate_get(char *buf, const struct kernel_param *kp)
+{
+ struct pt_rate_counts s;
+ int n = 0, i;
+ (void)kp;
+ dp_pt_rate_aggregate(&s);
+#define RP(...) n += scnprintf(buf + n, PAGE_SIZE - n, __VA_ARGS__)
+ RP("schema=1 enabled=%u completed=%llu valid=%llu invalid=%llu tries=%llu amsdu=%llu ldpc=%llu ppdus=%llu agg_ppdus=%llu agg_mpdus=%llu ast_overrides=%llu remote_peer_compl=%llu\n",
+    READ_ONCE(pt_rate_observe), s.completed, s.valid, s.invalid, s.tries,
+    s.amsdu, s.ldpc, s.ppdus, s.agg_ppdus, s.agg_mpdus, s.ast_overrides,
+    s.remote_peer_compl);
+#define RPA(name, count) do { RP(#name "="); for (i = 0; i < count; i++) RP("%s%llu", i ? "," : "", s.name[i]); RP("\n"); } while (0)
+ RPA(bw, 8); RPA(mcs, 16); RPA(pkt, 16); RPA(gi, 4); RPA(status, 17); RPA(tx_ring, 8); RPA(ppdu_bin, 6);
+#undef RPA
+#undef RP
+ return n;
+}
+static const struct kernel_param_ops pt_rate_ops = { .get = dp_pt_rate_get };
+module_param_cb(pt_rate_stats, &pt_rate_ops, NULL, 0444);
+static int dp_pt_ampdu_peak_get(char *buf, const struct kernel_param *kp)
+{
+ struct pt_rate_counts s;
+ (void)kp;
+ dp_pt_rate_aggregate(&s);
+ return scnprintf(buf, PAGE_SIZE, "max_ppdu_mpdus=%u last_peer_id=%u\n",
+                  s.max_ppdu_mpdus, s.last_peer_id);
+}
+static const struct kernel_param_ops pt_ampdu_peak_ops = { .get = dp_pt_ampdu_peak_get };
+module_param_cb(pt_ampdu_peak, &pt_ampdu_peak_ops, NULL, 0400);
+#endif
+#endif
diff --git a/qca-wifi-host-cmn/dp/wifi3.0/dp_pt_rx_phy.h b/qca-wifi-host-cmn/dp/wifi3.0/dp_pt_rx_phy.h
new file mode 100644
index 0000000000000000000000000000000000000000..174c7e69183905b7e8327f4a7b3484dd16901f1b
--- /dev/null
+++ b/qca-wifi-host-cmn/dp/wifi3.0/dp_pt_rx_phy.h
@@ -0,0 +1,204 @@
+/* Included only by the PASSTHRU raw RX implementation. */
+#include <linux/etherdevice.h>
+
+static u8 pt_rx_phy_mac[ETH_ALEN] __aligned(2);
+
+static int pt_rx_phy_peer_set(const char *value, const struct kernel_param *kp)
+{
+	u8 mac[ETH_ALEN] __aligned(2);
+
+	if (!THIS_MODULE || READ_ONCE(THIS_MODULE->state) != MODULE_STATE_COMING)
+		return -EPERM;
+	if (is_valid_ether_addr(pt_rx_phy_mac) || strlen(value) != 17 ||
+	    !mac_pton(value, mac) || !is_valid_ether_addr(mac))
+		return -EINVAL;
+
+	ether_addr_copy(pt_rx_phy_mac, mac);
+	return 0;
+}
+
+static int pt_rx_phy_peer_get(char *buf, const struct kernel_param *kp)
+{
+	if (!is_valid_ether_addr(pt_rx_phy_mac))
+		return scnprintf(buf, PAGE_SIZE, "unset\n");
+	return scnprintf(buf, PAGE_SIZE, "%pM\n", pt_rx_phy_mac);
+}
+
+static const struct kernel_param_ops pt_rx_phy_peer_ops = {
+	.set = pt_rx_phy_peer_set,
+	.get = pt_rx_phy_peer_get,
+};
+module_param_cb(pt_rx_phy_peer, &pt_rx_phy_peer_ops, NULL, 0400);
+
+enum pt_rx_phy_count {
+	PT_PHY_MATCHED,
+	PT_PHY_FCS,
+	PT_PHY_LAYOUT,
+	PT_PHY_NOT_DONE,
+	PT_PHY_PPDU_MISMATCH,
+	PT_PHY_RANGE,
+	PT_PHY_OUTSIDE_SCOPE,
+	PT_PHY_VALID,
+	PT_PHY_RETRY,
+	PT_PHY_AMSDU,
+	PT_PHY_RX_AMPDU,
+	PT_PHY_COUNTS,
+};
+
+static atomic64_t pt_phy_counts[PT_PHY_COUNTS];
+static atomic64_t pt_phy_packet_type[16];
+static atomic64_t pt_phy_type_bw[4][3];
+static atomic64_t pt_phy_mcs[2][16];
+static atomic64_t pt_phy_nss[2][8];
+static atomic64_t pt_phy_gi[2][4];
+static atomic64_t pt_phy_reception[8];
+static atomic64_t pt_phy_qos_ack[4];
+static atomic64_t pt_phy_length[4];
+
+static int pt_rx_phy_hist(char *buf, int used, const char *name,
+			 atomic64_t *values, unsigned int count)
+{
+	unsigned int i;
+
+	used += scnprintf(buf + used, PAGE_SIZE - used, " %s=", name);
+	for (i = 0; i < count; i++)
+		used += scnprintf(buf + used, PAGE_SIZE - used, "%s%lld",
+				  i ? "," : "", atomic64_read(&values[i]));
+	return used;
+}
+
+static int pt_rx_phy_stats_get(char *buf, const struct kernel_param *kp)
+{
+	int used;
+
+	used = scnprintf(buf, PAGE_SIZE,
+			"schema=1 enabled=%u matched=%lld fcs=%lld layout=%lld not_done=%lld"
+			" ppdu_mismatch=%lld range=%lld outside_scope=%lld valid=%lld"
+			" retry=%lld amsdu=%lld rx_ampdu=%lld ampdu=unknown",
+			is_valid_ether_addr(pt_rx_phy_mac),
+			atomic64_read(&pt_phy_counts[PT_PHY_MATCHED]),
+			atomic64_read(&pt_phy_counts[PT_PHY_FCS]),
+			atomic64_read(&pt_phy_counts[PT_PHY_LAYOUT]),
+			atomic64_read(&pt_phy_counts[PT_PHY_NOT_DONE]),
+			atomic64_read(&pt_phy_counts[PT_PHY_PPDU_MISMATCH]),
+			atomic64_read(&pt_phy_counts[PT_PHY_RANGE]),
+			atomic64_read(&pt_phy_counts[PT_PHY_OUTSIDE_SCOPE]),
+			atomic64_read(&pt_phy_counts[PT_PHY_VALID]),
+			atomic64_read(&pt_phy_counts[PT_PHY_RETRY]),
+			atomic64_read(&pt_phy_counts[PT_PHY_AMSDU]),
+			atomic64_read(&pt_phy_counts[PT_PHY_RX_AMPDU]));
+	used = pt_rx_phy_hist(buf, used, "packet_type", pt_phy_packet_type, 16);
+	used = pt_rx_phy_hist(buf, used, "ofdm_bw", pt_phy_type_bw[0], 3);
+	used = pt_rx_phy_hist(buf, used, "cck_bw", pt_phy_type_bw[1], 3);
+	used = pt_rx_phy_hist(buf, used, "ht_bw", pt_phy_type_bw[2], 3);
+	used = pt_rx_phy_hist(buf, used, "vht_bw", pt_phy_type_bw[3], 3);
+	used = pt_rx_phy_hist(buf, used, "ht_mcs", pt_phy_mcs[0], 16);
+	used = pt_rx_phy_hist(buf, used, "vht_mcs", pt_phy_mcs[1], 10);
+	used = pt_rx_phy_hist(buf, used, "ht_nss", pt_phy_nss[0], 8);
+	used = pt_rx_phy_hist(buf, used, "vht_nss", pt_phy_nss[1], 8);
+	used = pt_rx_phy_hist(buf, used, "ht_gi", pt_phy_gi[0], 4);
+	used = pt_rx_phy_hist(buf, used, "vht_gi", pt_phy_gi[1], 4);
+	used = pt_rx_phy_hist(buf, used, "reception", pt_phy_reception, 8);
+	used = pt_rx_phy_hist(buf, used, "qos_ack_policy", pt_phy_qos_ack, 4);
+	used = pt_rx_phy_hist(buf, used, "raw_len", pt_phy_length, 4);
+	return used + scnprintf(buf + used, PAGE_SIZE - used, "\n");
+}
+
+static const struct kernel_param_ops pt_rx_phy_stats_ops = {
+	.get = pt_rx_phy_stats_get,
+};
+module_param_cb(pt_rx_phy_stats, &pt_rx_phy_stats_ops, NULL, 0400);
+
+/*
+ * Call before radiotap, with PASSTHRU admission and an existing DP vdev ref.
+ * The current observer counts only complete raw frames reaching this point.
+ */
+static void pt_rx_phy_record(struct dp_soc *soc, struct dp_vdev *vdev,
+			     qdf_nbuf_t nbuf, u8 *tlvs, u32 tlv_len,
+			     bool fcs_error)
+{
+	static const u8 awdl_bssid[ETH_ALEN] = {0x00, 0x25, 0x00, 0xff, 0x94, 0x73};
+	struct hal_soc *hal = (struct hal_soc *)soc->hal_soc;
+	const u8 *raw = qdf_nbuf_data(nbuf);
+	u32 len = qdf_nbuf_len(nbuf), type, bw, reception, mcs, nss, gi, row;
+	enum pt_rx_phy_count result;
+
+	if (!is_valid_ether_addr(pt_rx_phy_mac) || len <= 26 || raw[0] != 0x88 ||
+	    (raw[1] & 0xc7) || (raw[22] & 0x0f) ||
+	    memcmp(raw + 4, vdev->mac_addr.raw, ETH_ALEN) ||
+	    memcmp(raw + 10, pt_rx_phy_mac, ETH_ALEN) ||
+	    memcmp(raw + 16, awdl_bssid, ETH_ALEN))
+		return;
+
+	atomic64_inc(&pt_phy_counts[PT_PHY_MATCHED]);
+	if (fcs_error) {
+		result = PT_PHY_FCS;
+		goto count;
+	}
+
+	atomic64_add(!!(raw[1] & 0x08), &pt_phy_counts[PT_PHY_RETRY]);
+	atomic64_add(!!(raw[24] & 0x80), &pt_phy_counts[PT_PHY_AMSDU]);
+	atomic64_inc(&pt_phy_qos_ack[(raw[24] >> 5) & 3]);
+	atomic64_inc(&pt_phy_length[len < 512 ? 0 : len < 1536 ? 1 : len < 3072 ? 2 : 3]);
+
+	if (!IS_ENABLED(QCA_WIFI_KIWI_V2) || IS_ENABLED(CONFIG_WORD_BASED_TLV) ||
+	    tlv_len != 272 || hal->target_type != TARGET_TYPE_KIWI) {
+		result = PT_PHY_LAYOUT;
+		goto count;
+	}
+	if (!hal_rx_attn_msdu_done_get(soc->hal_soc, tlvs)) {
+		result = PT_PHY_NOT_DONE;
+		goto count;
+	}
+	if (hal_rx_attn_phy_ppdu_id_get(soc->hal_soc, tlvs) !=
+	    hal_rx_get_ppdu_id(soc->hal_soc, tlvs)) {
+		result = PT_PHY_PPDU_MISMATCH;
+		goto count;
+	}
+	atomic64_add(!!hal_rx_mpdu_info_ampdu_flag_get(soc->hal_soc, tlvs),
+		     &pt_phy_counts[PT_PHY_RX_AMPDU]);
+
+	type = hal_rx_tlv_get_pkt_type(soc->hal_soc, tlvs);
+	bw = hal_rx_tlv_bw_get(soc->hal_soc, tlvs);
+	reception = hal_rx_msdu_start_reception_type_get(soc->hal_soc, tlvs);
+	if (type >= ARRAY_SIZE(pt_phy_packet_type) ||
+	    reception >= ARRAY_SIZE(pt_phy_reception)) {
+		result = PT_PHY_RANGE;
+		goto count;
+	}
+	atomic64_inc(&pt_phy_packet_type[type]);
+	atomic64_inc(&pt_phy_reception[reception]);
+
+	if (reception != 0 || bw > 2 ||
+	    (type != HAL_DOT11A && type != HAL_DOT11B &&
+	     type != HAL_DOT11N_MM && type != HAL_DOT11N_GF && type != HAL_DOT11AC)) {
+		result = PT_PHY_OUTSIDE_SCOPE;
+		goto count;
+	}
+	if (type == HAL_DOT11A || type == HAL_DOT11B) {
+		if (bw != 0) {
+			result = PT_PHY_RANGE;
+			goto count;
+		}
+		atomic64_inc(&pt_phy_type_bw[type == HAL_DOT11B][bw]);
+		result = PT_PHY_VALID;
+		goto count;
+	}
+
+	row = type == HAL_DOT11AC;
+	mcs = hal_rx_tlv_rate_mcs_get(soc->hal_soc, tlvs);
+	nss = hal_rx_msdu_start_nss_get(soc->hal_soc, tlvs);
+	gi = hal_rx_tlv_sgi_get(soc->hal_soc, tlvs);
+	if ((!row && bw > 1) || mcs > (row ? 9 : 15) || nss == 0 ||
+	    nss >= ARRAY_SIZE(pt_phy_nss[row]) || gi >= ARRAY_SIZE(pt_phy_gi[row])) {
+		result = PT_PHY_RANGE;
+		goto count;
+	}
+	atomic64_inc(&pt_phy_type_bw[2 + row][bw]);
+	atomic64_inc(&pt_phy_mcs[row][mcs]);
+	atomic64_inc(&pt_phy_nss[row][nss]);
+	atomic64_inc(&pt_phy_gi[row][gi]);
+	result = PT_PHY_VALID;
+count:
+	atomic64_inc(&pt_phy_counts[result]);
+}
diff --git a/qca-wifi-host-cmn/dp/wifi3.0/dp_pt_tx_observer.h b/qca-wifi-host-cmn/dp/wifi3.0/dp_pt_tx_observer.h
new file mode 100644
index 0000000000000000000000000000000000000000..11e4ab306d3ce8f2c205b6feebab6e675f7bd2b0
--- /dev/null
+++ b/qca-wifi-host-cmn/dp/wifi3.0/dp_pt_tx_observer.h
@@ -0,0 +1,178 @@
+/* SPDX-License-Identifier: ISC */
+#ifndef DP_PT_TX_OBSERVER_H
+#define DP_PT_TX_OBSERVER_H
+#ifdef DRIVER_PASSTHRU_DP
+#include <linux/cache.h>
+#include <linux/irqflags.h>
+#include <linux/ktime.h>
+#include <linux/moduleparam.h>
+#include <linux/smp.h>
+#include <linux/spinlock.h>
+#include <linux/threads.h>
+#include <cdp_txrx_ops.h>
+#include "pt_tx_observer_core.h"
+
+/* Load-time only: prevents untracked frames straddling an enable/reset. */
+static bool pt_tx_observe;
+module_param_named(pt_tx_observe, pt_tx_observe, bool, 0444);
+MODULE_PARM_DESC(pt_tx_observe, "Passive PASSTHRU TX ledger; enable at module load");
+
+struct dp_pt_tx_fast_counts {
+	u64 calls;
+	u64 accepted;
+	u64 rejected;
+	u64 rej_validate;
+	u64 rej_vdev;
+	u64 rej_dma;
+	u64 rej_desc;
+	u64 rej_hw_enq;
+};
+
+struct dp_pt_tx_cpu_slot {
+	struct dp_pt_tx_fast_counts c;
+} ____cacheline_aligned_in_smp;
+
+static struct dp_pt_tx_cpu_slot pt_tx_fast_cpu[NR_CPUS];
+static DEFINE_SPINLOCK(pto_lock);
+static struct pto_state pto;
+static u64 pto_epoch_ns;
+
+static void dp_pto_record_status(enum cdp_pt_tx_status st)
+{
+	unsigned long flags;
+	unsigned int cpu;
+
+	local_irq_save(flags);
+	cpu = smp_processor_id();
+	if (likely(cpu < ARRAY_SIZE(pt_tx_fast_cpu))) {
+		struct dp_pt_tx_fast_counts *r = &pt_tx_fast_cpu[cpu].c;
+
+		WRITE_ONCE(r->calls, r->calls + 1);
+		switch (st) {
+		case CDP_PT_TX_OK:
+			WRITE_ONCE(r->accepted, r->accepted + 1);
+			break;
+		case CDP_PT_TX_DROP_VALIDATE:
+			WRITE_ONCE(r->rejected, r->rejected + 1);
+			WRITE_ONCE(r->rej_validate, r->rej_validate + 1);
+			break;
+		case CDP_PT_TX_DROP_VDEV:
+			WRITE_ONCE(r->rejected, r->rejected + 1);
+			WRITE_ONCE(r->rej_vdev, r->rej_vdev + 1);
+			break;
+		case CDP_PT_TX_DROP_DMA:
+			WRITE_ONCE(r->rejected, r->rejected + 1);
+			WRITE_ONCE(r->rej_dma, r->rej_dma + 1);
+			break;
+		case CDP_PT_TX_BUSY_DESC:
+			WRITE_ONCE(r->rejected, r->rejected + 1);
+			WRITE_ONCE(r->rej_desc, r->rej_desc + 1);
+			break;
+		case CDP_PT_TX_BUSY_HW_ENQ:
+			WRITE_ONCE(r->rejected, r->rejected + 1);
+			WRITE_ONCE(r->rej_hw_enq, r->rej_hw_enq + 1);
+			break;
+		}
+	}
+	local_irq_restore(flags);
+}
+
+static void dp_pto_begin(struct dp_tx_desc_s *d, qdf_nbuf_t nbuf)
+{
+	unsigned long flags;
+	const u8 *frame;
+	u8 cls;
+	u32 bytes;
+
+	if (!pt_tx_observe || !dp_tx_desc_is_passthru(d))
+		return;
+	/* Called before tx_hw_enqueue owns the descriptor. Raw header validated. */
+	frame = qdf_nbuf_data(nbuf);
+	bytes = qdf_nbuf_headlen(nbuf);
+	cls = (bytes >= 10 && (frame[0] & 0x0c) == 0x08) ?
+	      ((frame[4] & 1) ? 1 : 0) : 2;
+	spin_lock_irqsave(&pto_lock, flags);
+	if (!pto_epoch_ns)
+		pto_epoch_ns = ktime_get_ns();
+	pto_begin(&pto, (unsigned long)d, ktime_get_ns(), bytes, cls);
+	spin_unlock_irqrestore(&pto_lock, flags);
+}
+
+static void dp_pto_end(struct dp_tx_desc_s *d,
+		       const struct hal_tx_completion_status *ts)
+{
+	unsigned long flags;
+
+	if (!pt_tx_observe || !dp_tx_desc_is_passthru(d))
+		return;
+	spin_lock_irqsave(&pto_lock, flags);
+	pto_end(&pto, (unsigned long)d, ktime_get_ns(),
+		ts ? ts->status : -1, ts ? ts->transmit_cnt : 0);
+	spin_unlock_irqrestore(&pto_lock, flags);
+}
+
+static int dp_pto_get(char *buf, const struct kernel_param *kp)
+{
+	struct dp_pt_tx_fast_counts fc;
+	struct pto_stats s;
+	unsigned long flags;
+	u64 now, oldest, epoch;
+	unsigned int cpu, c, i;
+	int n = 0;
+
+	(void)kp;
+	memset(&fc, 0, sizeof(fc));
+	for (cpu = 0; cpu < ARRAY_SIZE(pt_tx_fast_cpu); cpu++) {
+		const struct dp_pt_tx_fast_counts *r = &pt_tx_fast_cpu[cpu].c;
+
+		fc.calls += READ_ONCE(r->calls);
+		fc.accepted += READ_ONCE(r->accepted);
+		fc.rejected += READ_ONCE(r->rejected);
+		fc.rej_validate += READ_ONCE(r->rej_validate);
+		fc.rej_vdev += READ_ONCE(r->rej_vdev);
+		fc.rej_dma += READ_ONCE(r->rej_dma);
+		fc.rej_desc += READ_ONCE(r->rej_desc);
+		fc.rej_hw_enq += READ_ONCE(r->rej_hw_enq);
+	}
+
+	spin_lock_irqsave(&pto_lock, flags);
+	now = ktime_get_ns();
+	if (!pto_epoch_ns)
+		pto_epoch_ns = now;
+	epoch = pto_epoch_ns;
+	oldest = pt_tx_observe ? pto_oldest(&pto, now) : 0;
