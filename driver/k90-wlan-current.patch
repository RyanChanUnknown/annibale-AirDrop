+bool hdd_pt_control_params_is_2ss(const struct wondertap_init_params *params)
+{
+	return hdd_pt_vht80_2ss(params);
+}
+
+bool hdd_pt_control_params_vht80(const struct wondertap_init_params *params)
+{
+	return hdd_pt_vht80(params);
+}
+
+
+static int hdd_pt_control_channel(struct hdd_context *hdd, u32 freq)
+{
+	if (!WLAN_REG_IS_24GHZ_CH_FREQ(freq) &&
+	    !WLAN_REG_IS_5GHZ_CH_FREQ(freq))
+		return -EOPNOTSUPP;
+	/* Channel 14 permits legacy DSSS, not this HT-only profile. */
+	if (freq == 2484)
+		return -EOPNOTSUPP;
+	if (wlan_reg_get_channel_state_for_pwrmode(hdd->pdev, freq,
+			REG_CURRENT_PWR_MODE) != CHANNEL_STATE_ENABLE ||
+	    wlan_reg_is_dfs_for_freq(hdd->pdev, freq) ||
+	    wlan_reg_is_passive_for_freq(hdd->pdev, freq))
+		return -EPERM;
+	return 0;
+}
+
+int hdd_pt_control_validate(struct hdd_context *hdd,
+			   const struct wondertap_init_params *params)
+{
+	u8 country[3] = {0};
+	QDF_STATUS status;
+
+	if (!hdd || !hdd->pdev || !hdd->psoc || !params)
+		return -EINVAL;
+	if (!is_valid_ether_addr(params->mac_addr) ||
+	    !is_valid_ether_addr(params->bssid) ||
+	    params->country_code[2] || !params->country_code[0] ||
+	    !params->country_code[1] || params->reserved1 ||
+	    params->reserved2 || params->reserved3 ||
+	    params->tx_rate.reserved[0] || params->tx_rate.reserved[1])
+		return -EINVAL;
+	if ((!hdd_pt_vht80(params) &&
+	    (params->channel.bandwidth != WONDERTAP_RATE_BW_20 ||
+	    params->tx_rate.bw != WONDERTAP_RATE_BW_20 ||
+	    params->tx_rate.preamble != WONDERTAP_RATE_PREAMBLE_HT)) ||
+	    (hdd_pt_vht80_2ss(params) ?
+	     (params->tx_rate.nss < 1 || params->tx_rate.nss > 2 ||
+	      params->tx_rate.mcs > 9) :
+	     (params->tx_rate.nss != 1 || params->tx_rate.mcs > 7)) ||
+	    (params->tx_rate.gi != WONDERTAP_RATE_GI_DEFAULT &&
+	     params->tx_rate.gi != WONDERTAP_RATE_GI_SHORT) ||
+	    params->amsdu_enable || params->ampdu_enable ||
+	    params->mgmt_retry_limit || params->data_retry_limit) {
+		hdd_err("PT unsupported profile: freq %u channel_bw %u preamble %u rate_bw %u nss %u mcs %u gi %u vht80 %u vht80_2ss %u amsdu %u ampdu %u mgmt_retry %u data_retry %u",
+			params->channel.freq, params->channel.bandwidth,
+			params->tx_rate.preamble, params->tx_rate.bw,
+			params->tx_rate.nss, params->tx_rate.mcs,
+			params->tx_rate.gi, pt_vht80, pt_vht80_2ss,
+			params->amsdu_enable, params->ampdu_enable,
+			params->mgmt_retry_limit, params->data_retry_limit);
+		return -EOPNOTSUPP;
+	}
+	status = ucfg_reg_get_current_country(hdd->psoc, country);
+	if (QDF_IS_STATUS_ERROR(status))
+		return qdf_status_to_os_return(status);
+	if (memcmp(country, params->country_code, 2)) {
+		hdd_err("PT regulatory country mismatch: driver %.2s requested %.2s",
+			(const char *)country, (const char *)params->country_code);
+		return -EOPNOTSUPP;
+	}
+	if (ucfg_scan_get_pdev_status(hdd->pdev) != SCAN_NOT_IN_PROGRESS)
+		return -EBUSY;
+	if (hdd_pt_vht80(params)) {
+        u32 freq;
+        int ret;
+        for (freq = 5745; freq <= 5805; freq += 20) {
+            ret = hdd_pt_control_channel(hdd, freq);
+            if (ret)
+                return ret;
+        }
+    }
+    return hdd_pt_control_channel(hdd, params->channel.freq);
+}
+
+static int hdd_pt_control_state(struct hdd_pt_iface *iface,
+				const struct wondertap_init_params *params,
+				bool changing)
+{
+	struct hdd_pt_status state;
+	int ret;
+
+	if (!iface || !iface->adapter || !iface->adapter->deflink ||
+	    !iface->registry || !iface->vdev_created ||
+	    !iface->owner_started || iface->owner_reaped)
+		return -EINVAL;
+	ret = hdd_pt_control_validate(iface->hdd, params);
+	if (ret)
+		return ret;
+	if (iface->adapter->device_mode != QDF_PASSTHRU_MODE ||
+	    WLAN_HDD_GET_CTX(iface->adapter) != iface->hdd ||
+	    !ether_addr_equal(iface->adapter->mac_addr.bytes,
+			      params->mac_addr) ||
+	    (!changing && iface->frequency != params->channel.freq))
+		return -EINVAL;
+	ret = hdd_pt_status(iface->registry, iface->generation, &state);
+	if (ret)
+		return ret;
+	if (state.error)
+		return state.error;
+	return state.phase == (changing ? HDD_PT_ACTIVE : HDD_PT_BOUND) ?
+		0 : -EAGAIN;
+}
+
+static int hdd_pt_control_submit(struct hdd_pt_iface *iface,
+		const struct wondertap_init_params *params, u32 cookie, bool changing)
+{
+	struct channel_change_req request = {0};
+	enum phy_ch_width width = hdd_pt_vht80(params) ?
+        CH_WIDTH_80MHZ : CH_WIDTH_20MHZ;
+    struct ch_params channel = { .ch_width = width };
+	struct wlan_objmgr_vdev *vdev;
+	struct vdev_mlme_obj *mlme;
+	struct hdd_adapter *adapter;
+	QDF_STATUS status;
+	int ret;
+
+	ret = hdd_pt_control_state(iface, params, changing);
+	if (ret)
+		return ret;
+	adapter = iface->adapter;
+	ret = hdd_validate_channel_and_bandwidth(adapter, params->channel.freq,
+						 0, width);
+	if (ret) {
+		hdd_err("PT channel validation failed: freq %u width %u error %d",
+			params->channel.freq, width, ret);
+		return ret;
+	}
+	wlan_reg_set_channel_params_for_pwrmode(iface->hdd->pdev,
+			params->channel.freq, 0, &channel, REG_CURRENT_PWR_MODE);
+	if (channel.ch_width != width) {
+		hdd_err("PT channel width rejected: freq %u requested %u effective %u",
+			params->channel.freq, width, channel.ch_width);
+		return -EOPNOTSUPP;
+	}
+	if (hdd_pt_sta_coexist_mode()) {
+		struct hdd_adapter *sta;
+		struct wlan_hdd_link_info *link;
+
+		/* Until channel-change policy has its own validation, this
+		 * experimental coexistence session stays on its initial channel.
+		 */
+		if (changing)
+			return -EOPNOTSUPP;
+		if (!policy_mgr_allow_concurrency(iface->hdd->psoc,
+				PM_PASSTHRU_MODE, params->channel.freq,
+				width == CH_WIDTH_80MHZ ? HW_MODE_80_MHZ : HW_MODE_20_MHZ,
+				0, adapter->deflink->vdev_id)) {
+			hdd_err("PT coexist rejected: freq %u requires supported STA/DBS policy",
+				params->channel.freq);
+			return -EPERM;
+		}
+		iface->coexist_prepared = true;
+		wlan_hdd_set_roaming_state(adapter->deflink,
+					 RSO_PASSTHRU_SET_CHANNEL, false);
+		ret = wlan_hdd_change_hw_mode_for_given_chnl(adapter,
+				params->channel.freq,
+				POLICY_MGR_UPDATE_REASON_SET_OPER_CHAN);
+		if (ret)
+			return ret;
+		sta = hdd_get_adapter(iface->hdd, QDF_STA_MODE);
+		if (sta) {
+			hdd_adapter_for_each_active_link_info(sta, link) {
+				ret = wlan_hdd_set_powersave(link, false, 0);
+				if (ret)
+					return ret;
+			}
+		}
+		hdd_info("PT coexist hardware preparation complete freq %u",
+			 params->channel.freq);
+	}
+
+	vdev = hdd_objmgr_get_vdev_by_user(adapter->deflink, WLAN_OSIF_ID);
+	if (!vdev)
+		return -ENODEV;
+	if (!changing) {
+		status = wlan_vdev_mgr_set_param_bssid(vdev, params->bssid);
+		if (QDF_IS_STATUS_ERROR(status))
+			goto put;
+	}
+	mlme = wlan_vdev_mlme_get_cmpt_obj(vdev);
+	if (!mlme) {
+		status = QDF_STATUS_E_INVAL;
+		goto put;
+	}
+	wlan_vdev_obj_lock(vdev);
+	status = wlan_pt_txn_prepare(&mlme->passthru_txn, cookie,
+				     params->channel.freq);
+	wlan_vdev_obj_unlock(vdev);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto put;
+	request.passthru_cookie = cookie;
+
+	request.vdev_id = adapter->deflink->vdev_id;
+	request.target_chan_freq = params->channel.freq;
+	request.ch_width = channel.ch_width;
+	request.sec_ch_offset = channel.sec_ch_offset;
+	request.center_freq_seg0 = channel.center_freq_seg0;
+	request.center_freq_seg1 = channel.center_freq_seg1;
+	sme_fill_channel_change_request(iface->hdd->mac_handle, &request,
+				       hdd_pt_vht80(params) ? eCSR_DOT11_MODE_11ac : eCSR_DOT11_MODE_11n);
+	/* Do not let global PHY policy override the explicit profile. */
+    request.dot11mode = hdd_pt_vht80(params) ?
+        MLME_DOT11_MODE_11AC : MLME_DOT11_MODE_11N;
+	status = sme_send_channel_change_req(iface->hdd->mac_handle, &request);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wlan_vdev_obj_lock(vdev);
+		wlan_pt_txn_seal(&mlme->passthru_txn);
+		wlan_vdev_obj_unlock(vdev);
+	}
+put:
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+	return qdf_status_to_os_return(status);
+}
+
+int hdd_pt_control_submit_start(struct hdd_pt_iface *iface,
+                               const struct wondertap_init_params *params,
+                               u32 cookie)
+{
+	return hdd_pt_control_submit(iface, params, cookie, false);
+}
+
+int hdd_pt_control_submit_channel(struct hdd_pt_iface *iface,
+                                 const struct wondertap_init_params *params,
+                                 u32 cookie)
+{
+	return hdd_pt_control_submit(iface, params, cookie, true);
+}
+
+/* No configuration writes: callers may retry PENDING until their deadline. */
+int hdd_pt_control_check_start(struct hdd_pt_iface *iface, u32 cookie)
+{
+	struct wlan_objmgr_vdev *vdev;
+	struct vdev_mlme_obj *mlme;
+	QDF_STATUS status = QDF_STATUS_E_FAILURE;
+
+	if (!iface || !iface->adapter || !iface->adapter->deflink ||
+	    !iface->vdev_created || iface->owner_reaped)
+		return -EINVAL;
+	vdev = hdd_objmgr_get_vdev_by_user(iface->adapter->deflink, WLAN_OSIF_ID);
+	if (!vdev)
+		return -ENODEV;
+	mlme = wlan_vdev_mlme_get_cmpt_obj(vdev);
+	if (mlme) {
+		wlan_vdev_obj_lock(vdev);
+		status = wlan_pt_txn_completion(&mlme->passthru_txn, cookie);
+		wlan_vdev_obj_unlock(vdev);
+	}
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+	return status == QDF_STATUS_E_PENDING ? -EINPROGRESS :
+		qdf_status_to_os_return(status);
+}
+
+/* Serialized runtime control only; no waits or firmware commands. */
+void hdd_pt_control_abort(struct hdd_pt_iface *iface)
+{
+	struct wlan_objmgr_vdev *vdev;
+	struct vdev_mlme_obj *mlme;
+
+	if (!iface || !iface->adapter || !iface->adapter->deflink ||
+	    !iface->vdev_created || iface->owner_reaped)
+		return;
+	vdev = hdd_objmgr_get_vdev_by_user(iface->adapter->deflink, WLAN_OSIF_ID);
+	if (!vdev)
+		return;
+	mlme = wlan_vdev_mlme_get_cmpt_obj(vdev);
+	if (mlme) {
+		wlan_vdev_obj_lock(vdev);
+		wlan_pt_txn_seal(&mlme->passthru_txn);
+		wlan_vdev_obj_unlock(vdev);
+	}
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+}
+
+static int hdd_pt_control_vdev_param(tp_wma_handle wma, u8 vdev_id,
+				    u32 id, u32 value)
+{
+	struct vdev_set_params param = {
+		.vdev_id = vdev_id,
+		.param_id = id,
+		.param_value = value,
+	};
+
+	/* Unlike wma_cli_set_command, return the actual WMI send result. */
+	return qdf_status_to_os_return(
+		wmi_unified_vdev_set_param_send(wma->wmi_handle, &param));
+}
+
+/* Same TLV as wma_set_sw_retry_by_qos. Its public wrapper skips zero,
+ * so explicitly send zero for both aggregation classes on every AC.
+ * This controls firmware SOFTWARE retries; it is not proof that hardware
+ * retries are disabled. Do not advertise a hardware-retry capability.
+ */
+static int hdd_pt_control_no_sw_retry(tp_wma_handle wma, u8 vdev_id)
+{
+	wmi_vdev_set_custom_sw_retry_th_cmd_fixed_param *cmd;
+	wmi_buf_t buf;
+	u32 type, ac;
+	int ret;
+
+	for (type = 0; type < WMI_VDEV_CUSTOM_SW_RETRY_TYPE_MAX; type++) {
+		for (ac = 0; ac < WMI_AC_MAX; ac++) {
+			buf = wmi_buf_alloc(wma->wmi_handle, sizeof(*cmd));
+			if (!buf)
+				return -ENOMEM;
+			cmd = (void *)wmi_buf_data(buf);
+			qdf_mem_zero(cmd, sizeof(*cmd));
+			WMITLV_SET_HDR(&cmd->tlv_header,
+				WMITLV_TAG_STRUC_wmi_vdev_set_custom_sw_retry_th_cmd_fixed_param,
+				WMITLV_GET_STRUCT_TLVLEN(
+					wmi_vdev_set_custom_sw_retry_th_cmd_fixed_param));
+			cmd->vdev_id = vdev_id;
+			cmd->ac_type = ac;
+			cmd->sw_retry_type = type;
+			cmd->sw_retry_th = 0;
+			ret = wmi_unified_cmd_send(wma->wmi_handle, buf,
+						  sizeof(*cmd),
+					WMI_VDEV_SET_CUSTOM_SW_RETRY_TH_CMDID);
+			if (ret) {
+				wmi_buf_free(buf);
+				return qdf_status_to_os_return(ret);
+			}
+		}
+	}
+	return 0;
+}
+
+/* Default remains one MPDU/MSDU unless pt_tx_ampdu explicitly opens the
+ * outbound A-MPDU window to 64 MPDUs. Leave RX BA limits untouched.
+ */
+static int hdd_pt_control_tx_aggr(tp_wma_handle wma, u8 vdev_id,
+				  bool allow_ampdu)
+{
+	wmi_vdev_set_custom_aggr_size_cmd_fixed_param *cmd;
+	wmi_buf_t buf;
+	u32 type;
+	int ret;
+
+	for (type = 0; type < WMI_VDEV_CUSTOM_AGGR_TYPE_MAX; type++) {
+		buf = wmi_buf_alloc(wma->wmi_handle, sizeof(*cmd));
+		if (!buf)
+			return -ENOMEM;
+		cmd = (void *)wmi_buf_data(buf);
+		qdf_mem_zero(cmd, sizeof(*cmd));
+		WMITLV_SET_HDR(&cmd->tlv_header,
+			WMITLV_TAG_STRUC_wmi_vdev_set_custom_aggr_size_cmd_fixed_param,
+			WMITLV_GET_STRUCT_TLVLEN(
+				wmi_vdev_set_custom_aggr_size_cmd_fixed_param));
+		cmd->vdev_id = vdev_id;
+		cmd->tx_aggr_size =
+			(allow_ampdu && type == WMI_VDEV_CUSTOM_AGGR_TYPE_AMPDU) ?
+			64 : 1;
+		WMI_VDEV_CUSTOM_AGGR_TYPE_SET(cmd->enable_bitmap, type);
+		WMI_VDEV_CUSTOM_RX_AGGR_SZ_DIS_SET(cmd->enable_bitmap, 1);
+		ret = wmi_unified_cmd_send(wma->wmi_handle, buf, sizeof(*cmd),
+					  WMI_VDEV_SET_CUSTOM_AGGR_SIZE_CMDID);
+		if (ret) {
+			wmi_buf_free(buf);
+			return qdf_status_to_os_return(ret);
+		}
+	}
+	return 0;
+}
+
+int hdd_pt_control_finish_start(struct hdd_pt_iface *iface,
+			       const struct wondertap_init_params *params)
+{
+	struct ol_txrx_desc_type peer = {0};
+	struct wlan_objmgr_vdev *vdev;
+	struct hdd_adapter *adapter;
+	tp_wma_handle wma;
+	void *soc;
+	QDF_STATUS status;
+	u8 vdev_id;
+	int ret, rate;
+
+	ret = hdd_pt_control_state(iface, params, false);
+	if (ret)
+		return ret;
+	adapter = iface->adapter;
+	vdev_id = adapter->deflink->vdev_id;
+	wma = cds_get_context(QDF_MODULE_ID_WMA);
+	soc = cds_get_context(QDF_MODULE_ID_SOC);
+	if (!wma || !wma->wmi_handle || !soc)
+		return -ENODEV;
+	if (hdd_pt_sta_coexist_mode()) {
+		hdd_info("PT coexist firmware mapping vdev %u freq %u tx_streams %u",
+			 vdev_id,
+			 wma->interfaces[vdev_id].ch_freq,
+			 wma->interfaces[vdev_id].tx_streams);
+		if (wma->interfaces[vdev_id].tx_streams < params->tx_rate.nss)
+			return -EOPNOTSUPP;
+	}
+	if (hdd_pt_vht80_2ss(params)) {
+		ret = hdd_pt_control_vdev_param(wma, vdev_id,
+						wmi_vdev_param_nss,
+						params->tx_rate.nss);
+		if (ret)
+			return ret;
+		ret = hdd_pt_control_vdev_param(wma, vdev_id,
+						wmi_vdev_param_ldpc, 3);
+		if (ret)
+			return ret;
+	}
+	if (!pt_dynamic_rate) {
+		rate = hdd_assemble_rate_code(hdd_pt_vht80(params) ?
+			WMI_RATE_PREAMBLE_VHT : WMI_RATE_PREAMBLE_HT,
+			hdd_pt_vht80_2ss(params) ? (params->tx_rate.nss - 1) : 0,
+			params->tx_rate.mcs);
+		if (rate < 0)
+			return rate;
+		ret = hdd_pt_control_vdev_param(wma, vdev_id,
+						wmi_vdev_param_fixed_rate, rate);
+		if (ret)
+			return ret;
+	}
+	ret = hdd_pt_control_vdev_param(wma, vdev_id, wmi_vdev_param_sgi,
+			params->tx_rate.gi == WONDERTAP_RATE_GI_SHORT);
+	if (ret)
+		return ret;
+	ret = hdd_pt_control_vdev_param(wma, vdev_id,
+					wmi_vdev_param_chwidth, hdd_pt_vht80(params) ? 2 : 0);
+	if (ret)
+		return ret;
+	if (!pt_tx_ampdu) {
+		ret = hdd_pt_control_no_sw_retry(wma, vdev_id);
+		if (ret)
+			return ret;
+	}
+	ret = hdd_pt_control_tx_aggr(wma, vdev_id, pt_tx_ampdu);
+	if (ret)
+		return ret;
+
+	qdf_mem_copy(peer.peer_addr.bytes, adapter->mac_addr.bytes,
+		     QDF_MAC_ADDR_SIZE);
+	peer.is_qos_enabled = 1;
+	peer.bw = hdd_convert_ch_width_to_cdp_peer_bw(hdd_pt_vht80(params) ?
+        CH_WIDTH_80MHZ : CH_WIDTH_20MHZ);
+	status = cdp_peer_register(soc, OL_TXRX_PDEV_ID, &peer);
+	if (QDF_IS_STATUS_ERROR(status))
+		return qdf_status_to_os_return(status);
+	status = hdd_change_peer_state(adapter->deflink,
+				      adapter->mac_addr.bytes,
+				      OL_TXRX_PEER_STATE_AUTH);
+	if (QDF_IS_STATUS_ERROR(status))
+		return qdf_status_to_os_return(status);
+
+	if (hdd_pt_sta_coexist_mode() && !iface->policy_registered) {
+		policy_mgr_incr_active_session(iface->hdd->psoc,
+					      QDF_PASSTHRU_MODE, vdev_id, false);
+		status = policy_mgr_check_conn_with_mode_and_vdev_id(
+			iface->hdd->psoc, PM_PASSTHRU_MODE, vdev_id);
+		if (QDF_IS_STATUS_ERROR(status))
+			return qdf_status_to_os_return(status);
+		iface->policy_registered = true;
+		hdd_info("PT coexist session registered vdev %u", vdev_id);
+	}
+	if (pt_remote_multi) {
+		if (pt_remote_reo > 2)
+			return -EINVAL;
+		pt_remote_peer_set_reo_mode(pt_remote_reo);
+	}
+	if (pt_remote_assoc) {
+		bool vht80 = hdd_pt_vht80(params);
+		bool is_2ss = hdd_pt_vht80_2ss(params);
+		bool short_gi = params->tx_rate.gi == WONDERTAP_RATE_GI_SHORT;
+		struct wma_pt_peer_caps caps = {
+			.ht = true,
+			.vht = vht80,
+			.nss = is_2ss ? 2 : 1,
+			.bw = vht80 ? 80 : 20,
+			.max_mcs = vht80 ? 9 : 7,
+			.sgi = short_gi,
+			.ldpc = is_2ss,
+			.has_ht_bw40 = true,
+			.ht_bw40 = vht80,
+			.has_ht_sgi20 = true,
+			.ht_sgi20 = short_gi,
+			.has_ht_sgi40 = true,
+			.ht_sgi40 = vht80 && short_gi,
+			.has_ht_ldpc = true,
+			.ht_ldpc = is_2ss,
+			.has_vht_sgi80 = true,
+			.vht_sgi80 = vht80 && short_gi,
+			.has_vht_ldpc = true,
+			.vht_ldpc = vht80 && is_2ss,
+			.max_mpdu = 3895,
+			.ht_mcs_mask = is_2ss ? 0xffffU : 0x00ffU,
+		};
+		vdev = hdd_objmgr_get_vdev_by_user(adapter->deflink,
+						   WLAN_OSIF_ID);
+		if (!vdev)
+			return -ENODEV;
+		ret = wma_pt_remote_peer_setup_caps(vdev, iface->generation,
+						    pt_remote_mac, pt_remote_reo,
+						    &caps);
+		hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+void hdd_pt_coexist_release(struct hdd_pt_iface *iface)
+{
+	struct hdd_adapter *sta;
+	struct wlan_hdd_link_info *link;
+
+	if (iface->policy_registered) {
+		policy_mgr_decr_session_set_pcl(iface->hdd->psoc,
+			QDF_PASSTHRU_MODE, iface->adapter->deflink->vdev_id);
+		iface->policy_registered = false;
+	}
+	if (!iface->coexist_prepared)
+		return;
+	sta = hdd_get_adapter(iface->hdd, QDF_STA_MODE);
+	if (sta) {
+		hdd_adapter_for_each_active_link_info(sta, link)
+			wlan_hdd_set_powersave(link, sta->allow_power_save, 0);
+	}
+	wlan_hdd_set_roaming_state(iface->adapter->deflink,
+				 RSO_PASSTHRU_SET_CHANNEL, true);
+	iface->coexist_prepared = false;
+	hdd_info("PT coexist session released");
+}
diff --git a/qcacld-3.0/core/hdd/src/wlan_hdd_passthru_iface.c b/qcacld-3.0/core/hdd/src/wlan_hdd_passthru_iface.c
new file mode 100644
index 0000000000000000000000000000000000000000..a93252bf089beeac9636185c1b6f7c191305c9da
--- /dev/null
+++ b/qcacld-3.0/core/hdd/src/wlan_hdd_passthru_iface.c
@@ -0,0 +1,220 @@
+/* SPDX-License-Identifier: ISC */
+#include "wlan_hdd_passthru_iface.h"
+#ifndef HOUJI_PT_IFACE_HOST_TEST
+#include <linux/etherdevice.h>
+#include <linux/rtnetlink.h>
+#include "wlan_hdd_main.h"
+#include "wlan_hdd_passthru_experiment.h"
+#include "wlan_policy_mgr_ucfg.h"
+#endif
+
+static netdev_tx_t hdd_pt_netdev_tx(struct sk_buff *skb,
+				    struct net_device *dev)
+{
+	struct hdd_adapter *adapter = netdev_priv(dev);
+	struct hdd_pt_registry *registry =
+		READ_ONCE(adapter->passthru_registry);
+
+	if (registry)
+		return hdd_pt_tx_net(registry, adapter->passthru_generation,
+				     dev, skb);
+	dev_core_stats_tx_dropped_inc(dev);
+	dev_kfree_skb_any(skb);
+	return NETDEV_TX_OK;
+}
+
+static void hdd_pt_netdev_get_stats64(struct net_device *dev,
+				      struct rtnl_link_stats64 *storage)
+{
+	struct hdd_adapter *adapter = netdev_priv(dev);
+	struct hdd_pt_registry *registry =
+		READ_ONCE(adapter->passthru_registry);
+	unsigned int cpu;
+
+	if (!registry)
+		return;
+	for (cpu = 0; cpu < ARRAY_SIZE(registry->netstats); cpu++) {
+		const struct hdd_pt_netstats *s = &registry->netstats[cpu];
+
+		storage->tx_packets += READ_ONCE(s->tx_packets);
+		storage->tx_bytes += READ_ONCE(s->tx_bytes);
+		storage->tx_dropped += READ_ONCE(s->tx_dropped);
+		storage->rx_packets += READ_ONCE(s->rx_packets);
+		storage->rx_bytes += READ_ONCE(s->rx_bytes);
+		storage->rx_dropped += READ_ONCE(s->rx_dropped);
+	}
+}
+
+static int hdd_pt_netdev_open(struct net_device *dev)
+{
+	struct hdd_adapter *adapter = netdev_priv(dev);
+	struct hdd_pt_registry *registry =
+		READ_ONCE(adapter->passthru_registry);
+
+	if (!registry ||
+	    !hdd_pt_data_ready(registry, adapter->passthru_generation))
+		return -EAGAIN;
+	netif_carrier_on(dev);
+	netif_tx_start_all_queues(dev);
+	return 0;
+}
+
+static int hdd_pt_netdev_stop(struct net_device *dev)
+{
+	struct hdd_adapter *adapter = netdev_priv(dev);
+	struct hdd_pt_registry *registry =
+		READ_ONCE(adapter->passthru_registry);
+
+	netif_tx_stop_all_queues(dev);
+	netif_carrier_off(dev);
+	if (registry)
+		hdd_pt_close(registry, adapter->passthru_generation, "00", 2);
+	return 0;
+}
+
+static const struct net_device_ops hdd_pt_netdev_ops = {
+	.ndo_open = hdd_pt_netdev_open,
+	.ndo_stop = hdd_pt_netdev_stop,
+	.ndo_start_xmit = hdd_pt_netdev_tx,
+	.ndo_get_stats64 = hdd_pt_netdev_get_stats64,
+};
+
+void hdd_pt_set_netdev_ops(struct net_device *dev)
+{
+	dev->netdev_ops = &hdd_pt_netdev_ops;
+}
+
+int hdd_pt_iface_create(struct hdd_pt_iface *slot, struct hdd_context *hdd,
+			struct hdd_pt_registry *registry, u64 generation,
+			const u8 mac[6], const u8 bssid[6], u16 frequency)
+{
+	struct hdd_adapter_create_param params = {0};
+	u8 address[6];
+	int ret;
+
+	ASSERT_RTNL();
+	if (!slot || !hdd || !registry || !generation ||
+	    registry->generation != generation || !mac || !bssid ||
+	    !is_valid_ether_addr(mac) || !is_valid_ether_addr(bssid) ||
+	    frequency < 2300 || frequency > 7125)
+		return -EINVAL;
+	if (slot->create_attempted || slot->adapter)
+		return -EBUSY;
+#ifdef HOUJI_PT_IFACE_HOST_TEST
+	if (ucfg_policy_mgr_get_connection_count(hdd->psoc))
+		return -EBUSY;
+#else
+	if (ucfg_policy_mgr_get_connection_count(hdd->psoc) >
+	    (hdd_pt_sta_coexist_mode() ? 2 : 0))
+		return -EBUSY;
+#endif
+	/* Reserve before any side effect. Failure stays visible to the runtime
+	 * coordinator instead of producing a fresh adapter on init retry.
+	 */
+	slot->create_attempted = true;
+	slot->hdd = hdd;
+	slot->registry = registry;
+	slot->generation = generation;
+	slot->vdev_record.generation = generation;
+	slot->frequency = frequency;
+	memcpy(address, mac, sizeof(address));
+	params.num_sessions = 1;
+	slot->adapter = hdd_open_adapter(hdd, QDF_PASSTHRU_MODE, "wondertap0",
+					 address, NET_NAME_UNKNOWN, true, &params);
+	if (!slot->adapter) {
+		slot->error = -EIO;
+		return slot->error;
+	}
+	slot->adapter->passthru_generation = generation;
+	WRITE_ONCE(slot->adapter->passthru_registry, registry);
+	/* Deliberately bypass station initialization/ordinary Ethernet TX:
+	 * PASSTHRU PE creation and raw DP bind belong to the owner.
+	 */
+	ret = hdd_pt_vdev_create(slot->adapter->deflink, &slot->vdev_record);
+	if (ret)
+		goto blocked;
+	slot->vdev_created = true;
+	/* LIM channel-change looks up PE by the interface's own MAC.
+	 * The target BSSID is set separately in MLME by control_submit_start.
+	 */
+	ret = hdd_pt_start_record(registry, slot->adapter->deflink, frequency,
+				  mac, &slot->vdev_record);
+	if (ret)
+		goto blocked;
+	slot->owner_started = true;
+	return 0;
+blocked:
+	slot->error = ret;
+	return ret;
+}
+
+void hdd_pt_iface_close(struct hdd_pt_iface *slot,
+			const char country[3], unsigned int reason)
+{
+	if (slot && slot->owner_started && !slot->owner_reaped)
+		hdd_pt_close(slot->registry, slot->generation, country, reason);
+}
+
+/* Caller owns RTNL and the slot. Keep this shared tail free of owner waits. */
+static int hdd_pt_iface_cleanup_locked(struct hdd_pt_iface *slot)
+{
+	struct hdd_adapter *adapter = slot->adapter;
+
+	ASSERT_RTNL();
+	if (rcu_access_pointer(adapter->dev->rx_handler))
+		return -EBUSY;
+	dev_close(adapter->dev);
+	WRITE_ONCE(adapter->passthru_registry, NULL);
+	synchronize_net();
+#ifndef HOUJI_PT_IFACE_HOST_TEST
+	hdd_pt_coexist_release(slot);
+#endif
+	slot->adapter = NULL;
+	hdd_close_adapter(slot->hdd, adapter, true);
+	return 0;
+}
+
+int hdd_pt_iface_cleanup(struct hdd_pt_iface *slot)
+{
+	int ret;
+
+	if (!slot || !slot->adapter)
+		return 0;
+	if (!slot->owner_started)
+		return -EUCLEAN;
+	if (!slot->owner_reaped) {
+		hdd_pt_iface_close(slot, "00", 4);
+		ret = hdd_pt_reap(slot->registry);
+		if (ret)
+			return ret;
+		slot->owner_reaped = true;
+	}
+	rtnl_lock();
+	ret = hdd_pt_iface_cleanup_locked(slot);
+	rtnl_unlock();
+	return ret;
+}
+
+int hdd_pt_iface_recovery_cleanup(struct hdd_pt_iface *slot)
+{
+	int ret;
+
+	ASSERT_RTNL();
+	if (!slot)
+		return -EINVAL;
+	if (!slot->adapter)
+		return slot->owner_started && !slot->owner_reaped ? -EUCLEAN : 0;
+	if (!slot->owner_started)
+		return -EUCLEAN;
+	/* Retain the whole owner as well when the consumer still owns RX. */
+	if (rcu_access_pointer(slot->adapter->dev->rx_handler))
+		return -EBUSY;
+	if (!slot->owner_reaped) {
+		ret = hdd_pt_recovery_reap(slot->registry, slot->generation);
+		if (ret)
+			return ret;
+		slot->owner_reaped = true;
+	}
+	/* No extra gate dev_hold remains before netdev unregister. */
+	return hdd_pt_iface_cleanup_locked(slot);
+}
diff --git a/qcacld-3.0/core/hdd/src/wlan_hdd_passthru_owner.c b/qcacld-3.0/core/hdd/src/wlan_hdd_passthru_owner.c
new file mode 100644
index 0000000000000000000000000000000000000000..f32266d7fca7f00a282ba870727c84cd238090c0
--- /dev/null
+++ b/qcacld-3.0/core/hdd/src/wlan_hdd_passthru_owner.c
@@ -0,0 +1,1401 @@
+/* SPDX-License-Identifier: ISC */
+#include "wlan_hdd_passthru_owner.h"
+#include "wlan_hdd_wonder_handoff.h"
+#include "wlan_hdd_passthru_vdev.h"
+#ifndef HOUJI_PT_OWNER_HOST_TEST
+#include <linux/cache.h>
+#include <linux/etherdevice.h>
+#include <linux/delay.h>
+#include <linux/hrtimer.h>
+#include <linux/irqflags.h>
+#include <linux/ktime.h>
+#include <linux/moduleparam.h>
+#include <linux/mutex.h>
+#include <linux/netdevice.h>
+#include <linux/refcount.h>
+#include <linux/smp.h>
+#include <linux/workqueue.h>
+#include <linux/slab.h>
+#include "wlan_hdd_main.h"
+#include "wlan_hdd_object_manager.h"
+#include "wlan_vdev_mlme_api.h"
+#include "sme_passthru_request.h"
+#include "wlan_dp_passthru.h"
+#include "cds_api.h"
+#include "wma_api.h"
+#endif
+
+#define HDD_PT_RECHECK_MS 20
+#define HDD_PT_STOP_MS 6000
+#define HDD_PT_TX_WAKE_US 250
+
+#ifndef HOUJI_PT_OWNER_HOST_TEST
+static bool pt_tx_backpressure = true;
+module_param(pt_tx_backpressure, bool, 0644);
+MODULE_PARM_DESC(pt_tx_backpressure,
+		 "Pause wondertap0 TXQ via NETDEV_TX_BUSY on transient DP ring/desc exhaustion");
+
+struct hdd_pt_hdd_tx_counts {
+	u64 inactive;
+	u64 drop_validate;
+	u64 drop_vdev;
+	u64 drop_dma;
+	u64 busy_desc;
+	u64 busy_hw_enq;
+	u64 requeue;
+	u64 wake_cb;
+	u64 wake_skip_closing;
+};
+
+struct hdd_pt_hdd_tx_cpu {
+	struct hdd_pt_hdd_tx_counts c;
+} ____cacheline_aligned_in_smp;
+
+static struct hdd_pt_hdd_tx_cpu hdd_pt_tx_cpu[NR_CPUS];
+
+enum hdd_pt_tx_stat_kind {
+	HDD_PT_STAT_INACTIVE,
+	HDD_PT_STAT_DROP_VALIDATE,
+	HDD_PT_STAT_DROP_VDEV,
+	HDD_PT_STAT_DROP_DMA,
+	HDD_PT_STAT_BUSY_DESC,
+	HDD_PT_STAT_BUSY_HW_ENQ,
+	HDD_PT_STAT_REQUEUE,
+	HDD_PT_STAT_WAKE_CB,
+	HDD_PT_STAT_WAKE_SKIP_CLOSING,
+};
+
+static inline void hdd_pt_tx_stat_inc(enum hdd_pt_tx_stat_kind kind)
+{
+	unsigned long flags;
+	unsigned int cpu;
+
+	local_irq_save(flags);
+	cpu = smp_processor_id();
+	if (likely(cpu < ARRAY_SIZE(hdd_pt_tx_cpu))) {
+		struct hdd_pt_hdd_tx_counts *c = &hdd_pt_tx_cpu[cpu].c;
+
+		switch (kind) {
+		case HDD_PT_STAT_INACTIVE:
+			WRITE_ONCE(c->inactive, c->inactive + 1);
+			break;
+		case HDD_PT_STAT_DROP_VALIDATE:
+			WRITE_ONCE(c->drop_validate, c->drop_validate + 1);
+			break;
+		case HDD_PT_STAT_DROP_VDEV:
+			WRITE_ONCE(c->drop_vdev, c->drop_vdev + 1);
+			break;
+		case HDD_PT_STAT_DROP_DMA:
+			WRITE_ONCE(c->drop_dma, c->drop_dma + 1);
+			break;
+		case HDD_PT_STAT_BUSY_DESC:
+			WRITE_ONCE(c->busy_desc, c->busy_desc + 1);
+			break;
+		case HDD_PT_STAT_BUSY_HW_ENQ:
+			WRITE_ONCE(c->busy_hw_enq, c->busy_hw_enq + 1);
+			break;
+		case HDD_PT_STAT_REQUEUE:
+			WRITE_ONCE(c->requeue, c->requeue + 1);
+			break;
+		case HDD_PT_STAT_WAKE_CB:
+			WRITE_ONCE(c->wake_cb, c->wake_cb + 1);
+			break;
+		case HDD_PT_STAT_WAKE_SKIP_CLOSING:
+			WRITE_ONCE(c->wake_skip_closing,
+				   c->wake_skip_closing + 1);
+			break;
+		}
+	}
+	local_irq_restore(flags);
+}
+
+static inline void hdd_pt_netstats_tx(struct hdd_pt_registry *registry,
+				      bool ok, unsigned int bytes)
+{
+	unsigned long flags;
+	unsigned int cpu;
+
+	if (!registry)
+		return;
+	local_irq_save(flags);
+	cpu = smp_processor_id();
+	if (likely(cpu < ARRAY_SIZE(registry->netstats))) {
+		struct hdd_pt_netstats *s = &registry->netstats[cpu];
+
+		if (ok) {
+			WRITE_ONCE(s->tx_packets, s->tx_packets + 1);
+			WRITE_ONCE(s->tx_bytes, s->tx_bytes + bytes);
+		} else {
+			WRITE_ONCE(s->tx_dropped, s->tx_dropped + 1);
+		}
+	}
+	local_irq_restore(flags);
+}
+
+static inline void hdd_pt_netstats_rx(struct hdd_pt_registry *registry,
+				      bool ok, unsigned int bytes)
+{
+	unsigned long flags;
+	unsigned int cpu;
+
+	if (!registry)
+		return;
+	local_irq_save(flags);
+	cpu = smp_processor_id();
+	if (likely(cpu < ARRAY_SIZE(registry->netstats))) {
+		struct hdd_pt_netstats *s = &registry->netstats[cpu];
+
+		if (ok) {
+			WRITE_ONCE(s->rx_packets, s->rx_packets + 1);
+			WRITE_ONCE(s->rx_bytes, s->rx_bytes + bytes);
+		} else {
+			WRITE_ONCE(s->rx_dropped, s->rx_dropped + 1);
+		}
+	}
+	local_irq_restore(flags);
+}
+
+static int hdd_pt_hdd_tx_stats_get(char *buf, const struct kernel_param *kp)
+{
+	struct hdd_pt_hdd_tx_counts tot;
+	unsigned int cpu;
+
+	(void)kp;
+	memset(&tot, 0, sizeof(tot));
+	for (cpu = 0; cpu < ARRAY_SIZE(hdd_pt_tx_cpu); cpu++) {
+		const struct hdd_pt_hdd_tx_counts *c = &hdd_pt_tx_cpu[cpu].c;
+
+		tot.inactive += READ_ONCE(c->inactive);
+		tot.drop_validate += READ_ONCE(c->drop_validate);
+		tot.drop_vdev += READ_ONCE(c->drop_vdev);
+		tot.drop_dma += READ_ONCE(c->drop_dma);
+		tot.busy_desc += READ_ONCE(c->busy_desc);
+		tot.busy_hw_enq += READ_ONCE(c->busy_hw_enq);
+		tot.requeue += READ_ONCE(c->requeue);
+		tot.wake_cb += READ_ONCE(c->wake_cb);
+		tot.wake_skip_closing += READ_ONCE(c->wake_skip_closing);
+	}
+	return scnprintf(buf, PAGE_SIZE,
+			 "backpressure=%u inactive=%llu drop_validate=%llu "
+			 "drop_vdev=%llu drop_dma=%llu busy_desc=%llu "
+			 "busy_hw_enq=%llu requeue=%llu wake_cb=%llu "
+			 "wake_skip_closing=%llu\n",
+			 READ_ONCE(pt_tx_backpressure), tot.inactive,
+			 tot.drop_validate, tot.drop_vdev, tot.drop_dma,
+			 tot.busy_desc, tot.busy_hw_enq, tot.requeue,
+			 tot.wake_cb, tot.wake_skip_closing);
+}
+static const struct kernel_param_ops hdd_pt_tx_stats_ops = {
+	.get = hdd_pt_hdd_tx_stats_get,
+};
+module_param_cb(pt_hdd_tx_stats, &hdd_pt_tx_stats_ops, NULL, 0444);
+#endif
+
+struct hdd_pt_owner {
+	refcount_t refs;
+	struct mutex control;
+	spinlock_t work_lock;
+	atomic_t recovering;
+	bool recovery_prepared;
+	bool recovery_collected;
+	struct hdd_pt_vdev_record *record;
+	struct delayed_work work;
+#ifndef HOUJI_PT_OWNER_HOST_TEST
+	struct hrtimer tx_wake_timer;
+	struct net_device *tx_dev;
+	atomic_t tx_wake_armed;
+#endif
+	struct hdd_wh_gate gate;
+	struct hdd_pt_registry *registry;
+	struct wlan_hdd_link_info *link;
+	struct wlan_objmgr_vdev *vdev;
+	struct cdp_soc_t *soc;
+	mac_handle_t mac;
+	struct sme_passthru_request *request;
+	struct wlan_dp_passthru_endpoint *endpoint;
+	enum sme_passthru_session_state pe_state;
+	enum sme_passthru_request_action action;
+	enum hdd_pt_phase phase;
+	atomic_t closing;
+	u16 frequency;
+	u8 vdev_id;
+	u8 bssid[6];
+	bool active;
+	bool channel_busy;
+	bool detach_attempted;
+	bool stop_armed;
+	bool stop_wait_started;
+	unsigned long stop_deadline;
+	int error;
+	int detach_error;
+};
+
+static void hdd_pt_put(void *context)
+{
+	struct hdd_pt_owner *owner = context;
+
+	if (refcount_dec_and_test(&owner->refs))
+		kfree(owner);
+}
+
+static bool hdd_pt_get(void *context)
+{
+	struct hdd_pt_owner *owner = context;
+
+	return refcount_inc_not_zero(&owner->refs);
+}
+
+/* Public operation tails are counted separately from the DP consumer ref.
+ * The registry pins the record until users == 0 AND cancel_work_sync returns.
+ */
+static struct hdd_pt_owner *
+hdd_pt_acquire(struct hdd_pt_registry *registry, u64 generation)
+{
+	struct hdd_pt_owner *owner = NULL;
+
+	spin_lock_bh(&registry->lock);
+	if (registry->generation == generation && !registry->reaping &&
+	    registry->owner && registry->users != UINT_MAX) {
+		owner = registry->owner;
+		registry->users++;
+	}
+	spin_unlock_bh(&registry->lock);
+	return owner;
+}
+
+static void hdd_pt_release(struct hdd_pt_registry *registry)
+{
+	spin_lock_bh(&registry->lock);
+	registry->users--;
+	if (!registry->users)
+		wake_up_all(&registry->idle);
+	spin_unlock_bh(&registry->lock);
+}
+
+static void hdd_pt_free_list(struct sk_buff *head)
+{
+	struct sk_buff *next;
+
+	while (head) {
+		next = qdf_nbuf_next(head);
+		qdf_nbuf_set_next(head, NULL);
+		qdf_nbuf_free(head);
+		head = next;
+	}
+}
+
+static void hdd_pt_rx(void *context, qdf_nbuf_t skb)
+{
+	struct hdd_pt_owner *owner = context;
+	struct hdd_wh_ticket ticket = {0};
+
+	if (hdd_wh_enter(&owner->gate, owner->gate.generation, &ticket)) {
+		qdf_nbuf_free(skb);
+		return;
+	}
+	if (!smp_load_acquire(&owner->active)) {
+#ifndef HOUJI_PT_OWNER_HOST_TEST
+		hdd_pt_netstats_rx(owner->registry, false, 0);
+#endif
+		qdf_nbuf_free(skb);
+	} else {
+		/* DP already supplied radiotap + raw 802.11, not Ethernet.
+		 * The physical netdev's registered Wonder RX handler consumes it.
+		 * Never retain/call a pointer into Wonder's context or module.
+		 */
+#ifndef HOUJI_PT_OWNER_HOST_TEST
+		unsigned int rx_len = qdf_nbuf_len(skb);
+
+		hdd_pt_netstats_rx(owner->registry, true, rx_len);
+#endif
+		skb->dev = owner->gate.sink;
+		skb->protocol = htons(ETH_P_802_2);
+		skb_reset_mac_header(skb);
+		skb->pkt_type = PACKET_OTHERHOST;
+		skb->ip_summed = CHECKSUM_NONE;
+		netif_rx(skb);
+	}
+	hdd_wh_leave(&ticket);
+}
+
+#ifndef HOUJI_PT_OWNER_HOST_TEST
+static enum hrtimer_restart hdd_pt_tx_wake_cb(struct hrtimer *timer)
+{
+	struct hdd_pt_owner *owner =
+		container_of(timer, struct hdd_pt_owner, tx_wake_timer);
+
+	if (atomic_cmpxchg(&owner->tx_wake_armed, 1, 0) == 1) {
+		smp_mb__after_atomic();
+		if (atomic_read(&owner->closing) ||
+		    !smp_load_acquire(&owner->active)) {
+			hdd_pt_tx_stat_inc(HDD_PT_STAT_WAKE_SKIP_CLOSING);
+		} else if (owner->tx_dev && netif_running(owner->tx_dev)) {
+			hdd_pt_tx_stat_inc(HDD_PT_STAT_WAKE_CB);
+			netif_tx_wake_all_queues(owner->tx_dev);
+		}
+	}
+	return HRTIMER_NORESTART;
+}
+#endif
+
+static const struct wlan_dp_passthru_owner_ops hdd_pt_dp_ops = {
+	.get = hdd_pt_get,
+	.put = hdd_pt_put,
+	.rx = hdd_pt_rx,
+};
+
+static void hdd_pt_schedule(struct hdd_pt_owner *owner, unsigned long delay)
+{
+	/* Serialize check+enqueue against freeze before cancel_work_sync.
+	 * An atomic flag alone permits a late enqueue after cancellation.
+	 */
+	spin_lock_bh(&owner->work_lock);
+	if (!atomic_read(&owner->recovering))
+		mod_delayed_work(system_unbound_wq, &owner->work, delay);
+	spin_unlock_bh(&owner->work_lock);
+}
+
+static void hdd_pt_close_owner(struct hdd_pt_owner *owner,
+			       const char country[3], unsigned int reason)
+{
+	hdd_wh_close(&owner->gate, owner->gate.generation, country, reason);
+	atomic_set(&owner->closing, 1);
+	smp_store_release(&owner->active, false);
+#ifndef HOUJI_PT_OWNER_HOST_TEST
+	atomic_set(&owner->tx_wake_armed, 2);
+	hrtimer_try_to_cancel(&owner->tx_wake_timer);
+	if (owner->tx_dev && netif_running(owner->tx_dev))
+		netif_tx_wake_all_queues(owner->tx_dev);
+#endif
+}
+
+static void hdd_pt_block(struct hdd_pt_owner *owner, int error)
+{
+	if (!owner->error)
+		owner->error = error;
+	owner->phase = HDD_PT_BLOCKED;
+}
+
+/* No sleeping request wait under RTNL. Late CREATE results are collected by
+ * the same preallocated worker; cancellation is never treated as completion.
+ */
+static int hdd_pt_collect(struct hdd_pt_owner *owner)
+{
+	struct sme_passthru_request_result result;
+	QDF_STATUS status;
+
+	if (!owner->request)
+		return 0;
+	if (atomic_read(&owner->closing) &&
+	    owner->action == SME_PASSTHRU_REQUEST_CREATE)
+		sme_passthru_request_cancel(owner->request);
+	status = sme_passthru_request_query(owner->request, &result);
+	if (status == QDF_STATUS_E_PENDING)
+		return -EINPROGRESS;
+	if (QDF_IS_STATUS_ERROR(status))
+		return qdf_status_to_os_return(status);
+	owner->pe_state = result.session_state;
+	sme_passthru_request_put(owner->request);
+	owner->request = NULL;
+	if (owner->pe_state == SME_PASSTHRU_SESSION_UNKNOWN)
+		return -EUCLEAN;
+	if (owner->action == SME_PASSTHRU_REQUEST_DELETE &&
+	    owner->pe_state != SME_PASSTHRU_SESSION_ABSENT)
+		return QDF_IS_STATUS_ERROR(result.status) ?
+			qdf_status_to_os_return(result.status) : -EUCLEAN;
+	if (QDF_IS_STATUS_ERROR(result.status)) {
+		if (!owner->error)
+			owner->error = qdf_status_to_os_return(result.status);
+		hdd_pt_close_owner(owner, "00", 1);
+	}
+	return 0;
+}
+
+/* Caller holds owner->control and its close claim. No firmware waits.
+ * A PE delete result only releases PE ownership, not the asynchronous WMA
+ * stop. Keep the vdev pin until actual STOP/DOWN and their call tails finish.
+ */
+static int hdd_pt_stop_barrier(struct hdd_pt_owner *owner, bool arm_only)
+{
+	QDF_STATUS status;
+#ifndef HOUJI_PT_OWNER_HOST_TEST
+	struct vdev_mlme_obj *mlme = wlan_vdev_mlme_get_cmpt_obj(owner->vdev);
+
+	if (!mlme)
+		return -ENODEV;
+#endif
+	if (!owner->stop_wait_started) {
+		owner->stop_wait_started = true;
+		owner->stop_deadline = jiffies + msecs_to_jiffies(HDD_PT_STOP_MS);
+	}
+	if (time_after_eq(jiffies, owner->stop_deadline))
+		return -ETIMEDOUT;
+#ifdef HOUJI_PT_OWNER_HOST_TEST
+	status = host_stop_barrier(owner->vdev, &owner->stop_armed, arm_only);
+#else
+	wlan_vdev_obj_lock(owner->vdev);
+	if (!owner->stop_armed) {
+		if (mlme->passthru_txn.tx_busy || mlme->passthru_txn.rx_busy) {
+			status = QDF_STATUS_E_PENDING;
+			goto unlock;
+		}
+		/* Nonzero cookie conservatively includes queued/failed STARTs.
+		 * Never treat local INIT after a failed START as firmware proof.
+		 */
+		status = wlan_pt_stop_arm(&mlme->passthru_stop,
+					  mlme->passthru_txn.cookie != 0);
+		if (QDF_IS_STATUS_ERROR(status))
+			goto unlock;
+		wlan_pt_txn_seal(&mlme->passthru_txn);
+		owner->stop_armed = true;
+	}
+	status = arm_only ? QDF_STATUS_SUCCESS :
+		wlan_pt_stop_completion(&mlme->passthru_stop);
+unlock:
+	wlan_vdev_obj_unlock(owner->vdev);
+#endif
+	return status == QDF_STATUS_E_PENDING ? -EINPROGRESS :
+		qdf_status_to_os_return(status);
+}
+
+static void hdd_pt_work(struct work_struct *work)
+{
+	struct hdd_pt_owner *owner =
+		container_of(to_delayed_work(work), struct hdd_pt_owner, work);
+	struct hdd_wh_claim claim = {0};
+	QDF_STATUS status;
+	int ret;
+	bool again = false;
+
+	mutex_lock(&owner->control);
+	if (atomic_read(&owner->recovering) ||
+	    owner->phase == HDD_PT_DRAINED || owner->phase == HDD_PT_BLOCKED)
+		goto out;
+	ret = hdd_pt_collect(owner);
+	if (ret == -EINPROGRESS) {
+		again = true;
+		goto out;
+	}
+	if (ret) {
+		hdd_pt_close_owner(owner, "00", 1);
+		hdd_pt_block(owner, ret);
+		goto out;
+	}
+	if (!atomic_read(&owner->closing)) {
+		if (owner->pe_state != SME_PASSTHRU_SESSION_PRESENT) {
+			hdd_pt_close_owner(owner, "00", 1);
+			owner->error = -EIO;
+		} else if (!owner->endpoint) {
+			status = ucfg_dp_passthru_create(owner->soc, owner->vdev_id,
+					owner->frequency, &hdd_pt_dp_ops, owner,
+					&owner->endpoint);
+			if (QDF_IS_STATUS_ERROR(status)) {
+				owner->error = qdf_status_to_os_return(status);
+				hdd_pt_close_owner(owner, "00", 1);
+			} else {
+				owner->phase = HDD_PT_BOUND;
+			}
+		}
+		if (!atomic_read(&owner->closing))
+			goto out;
+	}
+
+	owner->phase = HDD_PT_CLOSING;
+	if (hdd_wh_try_claim(&owner->gate, owner->gate.generation, &claim)) {
+		again = true;
+		goto out;
+	}
+	if (owner->endpoint) {
+		status = ucfg_dp_passthru_stop(owner->endpoint);
+		if (status == QDF_STATUS_E_BUSY) {
+			again = true;
+			goto finish;
+		}
+		if (QDF_IS_STATUS_ERROR(status)) {
+			hdd_pt_block(owner, qdf_status_to_os_return(status));
+			goto finish;
+		}
+	}
+#ifndef HOUJI_PT_OWNER_HOST_TEST
+	ret = wma_pt_remote_peer_teardown(owner->vdev, owner->gate.generation);
+	if (ret) {
+		hdd_pt_block(owner, ret);
+		goto finish;
+	}
+#endif
+	if (owner->pe_state == SME_PASSTHRU_SESSION_PRESENT) {
+		ret = hdd_pt_stop_barrier(owner, true);
+		if (ret == -EINPROGRESS) {
+			again = true;
+			goto finish;
+		}
+		if (ret) {
+			hdd_pt_block(owner, ret);
+			goto finish;
+		}
+		owner->action = SME_PASSTHRU_REQUEST_DELETE;
+		status = sme_passthru_request_submit(owner->mac, owner->vdev,
+				owner->action, NULL, &owner->request);
+		if (QDF_IS_STATUS_ERROR(status)) {
+			hdd_pt_block(owner, qdf_status_to_os_return(status));
+			goto finish;
+		}
+		again = true;
+		goto finish;
+	}
+	if (owner->pe_state != SME_PASSTHRU_SESSION_ABSENT) {
+		hdd_pt_block(owner, -EUCLEAN);
+		goto finish;
+	}
+	if (!owner->detach_attempted) {
+		ret = hdd_pt_stop_barrier(owner, false);
+		if (ret == -EINPROGRESS) {
+			again = true;
+			goto finish;
+		}
+		if (ret) {
+			hdd_pt_block(owner, ret);
+			goto finish;
+		}
+		/* Release our objmgr ref before invoking the real HDD deletion.
+		 * A timed-out deletion is NEVER submitted a second time.
+		 */
+		hdd_objmgr_put_vdev_by_user(owner->vdev, WLAN_OSIF_ID);
+		owner->vdev = NULL;
+		owner->detach_attempted = true;
+		owner->detach_error = owner->record ?
+			hdd_pt_vdev_destroy(owner->link, owner->record) :
+			hdd_vdev_destroy(owner->link);
+	}
+	if (owner->endpoint) {
+		status = ucfg_dp_passthru_join(owner->endpoint);
+		if (status == QDF_STATUS_E_BUSY) {
+			again = true;
+			goto finish;
+		}
+		if (QDF_IS_STATUS_ERROR(status)) {
+			hdd_pt_block(owner, qdf_status_to_os_return(status));
+			goto finish;
+		}
+		ucfg_dp_passthru_put(owner->endpoint);
+		owner->endpoint = NULL;
+	}
+	if (owner->detach_error) {
+		hdd_pt_block(owner, owner->detach_error);
+		goto finish;
+	}
+	/* Extra sink ref goes away BEFORE caller unregisters the netdev.
+	 * Network backlog is handled by that real unregister, not this flag.
+	 */
+	hdd_wh_finish(&claim, true);
+#ifndef HOUJI_PT_OWNER_HOST_TEST
+	atomic_set(&owner->tx_wake_armed, 2);
+	hrtimer_cancel(&owner->tx_wake_timer);
+#endif
+	hdd_wh_release(&owner->gate);
+	owner->phase = HDD_PT_DRAINED;
+	goto out;
+finish:
+	hdd_wh_finish(&claim, false);
+out:
+	if (again)
+		hdd_pt_schedule(owner, msecs_to_jiffies(HDD_PT_RECHECK_MS));
+	mutex_unlock(&owner->control);
+}
+
+void hdd_pt_registry_init(struct hdd_pt_registry *registry, u64 generation)
+{
+	memset(registry, 0, sizeof(*registry));
+	spin_lock_init(&registry->lock);
+	init_waitqueue_head(&registry->idle);
+	registry->generation = generation;
+	registry->closed = !generation;
+}
+
+int hdd_pt_start_record(struct hdd_pt_registry *registry,
+		 struct wlan_hdd_link_info *link, u16 frequency,
+		 const u8 bssid[6], struct hdd_pt_vdev_record *record)
+{
+	struct hdd_pt_owner *owner;
+	QDF_STATUS status;
+	int ret = -EINVAL;
+
+	if (!link || !link->adapter || !link->adapter->dev ||
+	    !frequency || !bssid || !registry->generation)
+		return -EINVAL;
+	if (record && !hdd_pt_vdev_adoptable(record, link, registry->generation))
+		return -EINVAL;
+	owner = kzalloc(sizeof(*owner), GFP_KERNEL);
+	if (!owner)
+		return -ENOMEM;
+	owner->vdev = hdd_objmgr_get_vdev_by_user(link, WLAN_OSIF_ID);
+	if (!owner->vdev)
+		goto free;
+	if (record && record->vdev_id != wlan_vdev_get_id(owner->vdev))
+		goto put_vdev;
+	if (wlan_vdev_mlme_get_opmode(owner->vdev) != QDF_PASSTHRU_MODE)
+		goto put_vdev;
+	owner->soc = cds_get_context(QDF_MODULE_ID_SOC);
+	owner->mac = WLAN_HDD_GET_CTX(link->adapter)->mac_handle;
+	if (!owner->soc || !owner->mac)
+		goto put_vdev;
+	ret = hdd_wh_init(&owner->gate, link->adapter->dev,
+			  registry->generation);
+	if (ret)
+		goto put_vdev;
+	refcount_set(&owner->refs, 1); /* registry; DP installation adds its own */
+	mutex_init(&owner->control);
+	spin_lock_init(&owner->work_lock);
+	atomic_set(&owner->recovering, 0);
+	owner->record = record;
+	INIT_DELAYED_WORK(&owner->work, hdd_pt_work);
+#ifndef HOUJI_PT_OWNER_HOST_TEST
+	hrtimer_init(&owner->tx_wake_timer, CLOCK_MONOTONIC,
+		     HRTIMER_MODE_REL_SOFT);
+	owner->tx_wake_timer.function = hdd_pt_tx_wake_cb;
+	owner->tx_dev = link->adapter->dev;
+	atomic_set(&owner->tx_wake_armed, 0);
+#endif
+	atomic_set(&owner->closing, 0);
+	owner->registry = registry;
+	owner->link = link;
+	owner->frequency = frequency;
+	owner->vdev_id = wlan_vdev_get_id(owner->vdev);
+	memcpy(owner->bssid, bssid, sizeof(owner->bssid));
+	owner->phase = HDD_PT_CREATING;
+	owner->pe_state = SME_PASSTHRU_SESSION_ABSENT;
+	owner->action = SME_PASSTHRU_REQUEST_CREATE;
+	/* Hold the control mutex BEFORE publishing: retire may immediately
+	 * close/schedule us, but must not race initial request publication.
+	 */
+	mutex_lock(&owner->control);
+	spin_lock_bh(&registry->lock);
+	if (registry->closed || registry->reaping || registry->owner) {
+		ret = registry->closed ? -ESHUTDOWN : -EBUSY;
+		spin_unlock_bh(&registry->lock);
+		mutex_unlock(&owner->control);
+		dev_put(owner->gate.sink); /* never published */
+		goto put_vdev;
+	}
+	registry->owner = owner;
+	registry->users++; /* initial submit/schedule tail */
+	spin_unlock_bh(&registry->lock);
+	if (!atomic_read(&owner->closing)) {
+		status = sme_passthru_request_submit(owner->mac, owner->vdev,
+				owner->action, owner->bssid, &owner->request);
+		if (QDF_IS_STATUS_ERROR(status)) {
+			owner->error = qdf_status_to_os_return(status);
+			hdd_pt_close_owner(owner, "00", 1);
+		}
+	}
+	hdd_pt_schedule(owner, 0);
+	mutex_unlock(&owner->control);
+	hdd_pt_release(registry);
+	return 0;
+put_vdev:
+	hdd_objmgr_put_vdev_by_user(owner->vdev, WLAN_OSIF_ID);
+free:
+	kfree(owner);
+	return ret;
+}
+
+int hdd_pt_start(struct hdd_pt_registry *registry,
+		 struct wlan_hdd_link_info *link, u16 frequency,
+		 const u8 bssid[6])
+{
+	return hdd_pt_start_record(registry, link, frequency, bssid, NULL);
+}
+
+int hdd_pt_recovery_freeze(struct hdd_pt_registry *registry, u64 generation)
+{
+	struct hdd_pt_owner *owner;
+	struct hdd_wh_claim claim = {0};
+	QDF_STATUS status;
+	int ret = 0;
+
+	/* Stale recovery must not close a new epoch. Pin owner during cancellation. */
+	spin_lock_bh(&registry->lock);
+	if (registry->generation != generation || registry->reaping) {
+		spin_unlock_bh(&registry->lock);
+		return -ESTALE;
+	}
+	registry->closed = true;
+	owner = registry->owner;
+	if (!owner) {
+		spin_unlock_bh(&registry->lock);
+		return 0;
+	}
+	if (registry->users == UINT_MAX) {
+		spin_unlock_bh(&registry->lock);
+		return -EOVERFLOW;
+	}
+	registry->users++;
+	spin_unlock_bh(&registry->lock);
+	spin_lock_bh(&owner->work_lock);
+	atomic_set(&owner->recovering, 1);
+	spin_unlock_bh(&owner->work_lock);
+	hdd_pt_close_owner(owner, "00", 8);
+	cancel_delayed_work_sync(&owner->work);
+	mutex_lock(&owner->control);
+	if (owner->phase == HDD_PT_DRAINED) {
+		owner->recovery_prepared = true;
+		goto out;
+	}
+	owner->phase = HDD_PT_RECOVERING;
+	if (owner->recovery_prepared)
+		goto out;
+	ret = hdd_wh_try_claim(&owner->gate, generation, &claim);
+	if (ret)
+		goto out;
+	if (owner->endpoint) {
+		status = ucfg_dp_passthru_stop(owner->endpoint);
+		if (QDF_IS_STATUS_ERROR(status)) {
+			ret = qdf_status_to_os_return(status);
+			goto finish;
+		}
+	}
+	/* Requests/DP hold their own refs. Preserve them until real completion.
+	 * Releasing ours allows later host teardown to make progress.
+	 */
+	if (owner->vdev) {
+		hdd_objmgr_put_vdev_by_user(owner->vdev, WLAN_OSIF_ID);
+		owner->vdev = NULL;
+	}
+	owner->recovery_prepared = true;
+finish:
+	hdd_wh_finish(&claim, false);
+out:
+	mutex_unlock(&owner->control);
+	hdd_pt_release(registry);
+	return ret;
+}
+
+/* The CDS caller has closed admission, joined scheduler/WMI/RX and completed
+ * this epoch's PE purge. Do not reuse pre-purge request session-state results.
+ * This collects local handles only; gate/netdev/registry ownership stays put.
+ */
+int hdd_pt_recovery_collect(struct hdd_pt_registry *registry, u64 generation)
+{
+	struct hdd_pt_owner *owner;
+	struct hdd_wh_claim claim = {0};
+	struct sme_passthru_request_result result;
+	const struct sme_passthru_request_input *input;
+	struct sme_passthru_request *request;
+	struct hdd_pt_vdev_record *record;
+	QDF_STATUS status;
+	uint32_t outstanding = ~0U;
+	bool hdd_pin;
+	int ret = 0;
+
+	spin_lock_bh(&registry->lock);
+	if (registry->generation != generation || registry->reaping) {
+		spin_unlock_bh(&registry->lock);
+		return -ESTALE;
+	}
+	if (!registry->closed || registry->users == UINT_MAX) {
+		spin_unlock_bh(&registry->lock);
+		return -EBUSY;
+	}
+	owner = registry->owner;
+	if (!owner) {
+		spin_unlock_bh(&registry->lock);
+		return 0;
+	}
+	registry->users++;
+	spin_unlock_bh(&registry->lock);
+	/* CDS may hold a transition. Never wait for a control operation there. */
+	if (!mutex_trylock(&owner->control)) {
+		ret = -EBUSY;
+		goto release;
+	}
+	if (owner->phase == HDD_PT_DRAINED)
+		goto unlock;
+	if (!atomic_read(&owner->recovering) || !owner->recovery_prepared ||
+	    owner->vdev || owner->phase != HDD_PT_RECOVERING) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	if (owner->recovery_collected)
+		goto unlock;
+	if (owner->mac != cds_get_context(QDF_MODULE_ID_SME) ||
+	    owner->soc != cds_get_context(QDF_MODULE_ID_SOC)) {
+		ret = -ESTALE;
+		goto unlock;
+	}
+	status = sme_passthru_requests_drain_status(owner->mac, &outstanding);
+	if (QDF_IS_STATUS_ERROR(status) || outstanding) {
+		ret = QDF_IS_STATUS_ERROR(status) ?
+			qdf_status_to_os_return(status) : -EBUSY;
+		goto unlock;
+	}
+	ret = hdd_wh_try_claim(&owner->gate, generation, &claim);
+	if (ret)
+		goto unlock;
+	if (owner->request) {
+		status = sme_passthru_request_query(owner->request, &result);
+		if (QDF_IS_STATUS_ERROR(status)) {
+			ret = status == QDF_STATUS_E_PENDING ? -EBUSY :
+				qdf_status_to_os_return(status);
+			goto finish;
+		}
+		input = sme_passthru_request_input(owner->request);
+		if (!input || !input->vdev || input->vdev_id != owner->vdev_id ||
+		    wlan_vdev_get_id(input->vdev) != owner->vdev_id) {
+			ret = -EUCLEAN;
+			goto finish;
+		}
+		/* request_put could otherwise be the last objmgr ref, reentering
+		 * ordinary FW deletion after scheduler shutdown. Require an
+		 * independently owned HDD or blocked-SME ref to keep it alive.
+		 */
+		record = owner->record;
+		hdd_pin = record && record->generation == generation &&
+			record->link == owner->link &&
+			record->vdev_id == owner->vdev_id &&
+			(record->steps & HDD_PT_VDEV_HDD_REF_ACQUIRED) &&
+			!(record->steps & HDD_PT_VDEV_HDD_REF_RELEASED);
+		if (!hdd_pin) {
+			status = wma_passthru_recovery_request_guard(input->vdev);
+			if (QDF_IS_STATUS_ERROR(status)) {
+				ret = qdf_status_to_os_return(status);
+				goto finish;
+			}
+		}
+		if (!owner->error && QDF_IS_STATUS_ERROR(result.status))
+			owner->error = qdf_status_to_os_return(result.status);
+		request = owner->request;
+		owner->request = NULL;
+		sme_passthru_request_put(request);
+	}
+	/* Current absence comes from this invocation's external PE purge.
+	 * An old CREATE/PRESENT result must not initiate a new DELETE here.
+	 */
+	owner->pe_state = SME_PASSTHRU_SESSION_ABSENT;
+	if (owner->endpoint) {
+		status = ucfg_dp_passthru_join(owner->endpoint);
+		if (QDF_IS_STATUS_ERROR(status)) {
+			ret = qdf_status_to_os_return(status);
+			goto finish;
+		}
+		ucfg_dp_passthru_put(owner->endpoint);
+		owner->endpoint = NULL;
+	}
+	owner->recovery_collected = true;
+finish:
+	/* Keep the sink hold and RECOVERING phase, even after successful join.
+	 * CDS must still check global DP receipts and reap WMA parameters.
+	 */
+	hdd_wh_finish(&claim, false);
+unlock:
+	mutex_unlock(&owner->control);
+release:
+	hdd_pt_release(registry);
+	return ret;
+}
+
+int hdd_pt_status(struct hdd_pt_registry *registry, u64 generation,
+		  struct hdd_pt_status *status)
+{
+	struct hdd_pt_owner *owner;
+
+	if (!status)
+		return -EINVAL;
+	owner = hdd_pt_acquire(registry, generation);
+	if (!owner)
+		return -ENOENT;
+	mutex_lock(&owner->control);
+	status->phase = owner->phase;
+	status->error = owner->error;
+	status->detach_error = owner->detach_error;
+	status->detach_attempted = owner->detach_attempted;
+	status->recovery_prepared = owner->recovery_prepared;
+	status->recovery_collected = owner->recovery_collected;
+	mutex_unlock(&owner->control);
+	hdd_pt_release(registry);
+	return 0;
+}
+
+int hdd_pt_with_bound(struct hdd_pt_registry *registry, u64 generation,
+		       int (*operation)(void *context), void *context)
+{
+	struct hdd_pt_owner *owner;
+	struct hdd_wh_ticket ticket = {0};
+	int ret;
+
+	if (!operation)
+		return -EINVAL;
+	owner = hdd_pt_acquire(registry, generation);
+	if (!owner)
+		return -ENOENT;
+	mutex_lock(&owner->control);
+	if (owner->phase != HDD_PT_BOUND || atomic_read(&owner->closing))
+		ret = -ESHUTDOWN;
+	else
+		ret = hdd_wh_enter(&owner->gate, generation, &ticket);
+	mutex_unlock(&owner->control);
+	if (!ret) {
+		ret = operation(context);
+		hdd_wh_leave(&ticket);
+	}
+	hdd_pt_release(registry);
+	return ret;
+}
+
+/* Runtime serializes channel requests. The gate ticket pins endpoint/vdev
+ * through polling and the final callback tail; no owner mutex crosses WMI.
+ * May run under Wonder's mutex/RTNL. Never wait for work or take RTNL here.
+ */
+int hdd_pt_with_channel(struct hdd_pt_registry *registry, u64 generation,
+		       u16 frequency, unsigned long deadline,
+		       int (*operation)(void *context), void *context)
+{
+	struct hdd_pt_owner *owner;
+	struct hdd_wh_ticket ticket = {0};
+	QDF_STATUS status;
+	int ret;
+
+	if (!operation || !frequency)
+		return -EINVAL;
+	owner = hdd_pt_acquire(registry, generation);
+	if (!owner)
+		return -ENOENT;
+	if (!mutex_trylock(&owner->control)) {
+		ret = -EBUSY;
+		goto release;
+	}
+	if (owner->phase != HDD_PT_ACTIVE || !owner->endpoint ||
+	    owner->channel_busy || atomic_read(&owner->closing)) {
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
+	ret = hdd_wh_enter(&owner->gate, generation, &ticket);
+	if (ret)
+		goto unlock;
+	owner->channel_busy = true;
+	smp_store_release(&owner->active, false);
+	mutex_unlock(&owner->control);
+
+	for (;;) {
+		ret = -ESHUTDOWN;
+		if (atomic_read(&owner->closing))
+			break;
+		ret = -ETIMEDOUT;
+		if (time_after_eq(jiffies, deadline))
+			break;
+		status = ucfg_dp_passthru_pause(owner->endpoint);
+		ret = qdf_status_to_os_return(status);
+		if (status != QDF_STATUS_E_BUSY)
+			break;
+		usleep_range(1000, 2000);
+	}
+	if (!ret)
+		ret = operation(context);
+	if (!ret && atomic_read(&owner->closing))
+		ret = -ESHUTDOWN;
+	if (!ret && time_after_eq(jiffies, deadline))
+		ret = -ETIMEDOUT;
+	if (!ret)
+		ret = qdf_status_to_os_return(
+			ucfg_dp_passthru_set_channel(owner->endpoint, frequency));
+
+	/* With our gate ticket alive, close work cannot enter vdev deletion.
+	 * It may briefly own control, but cannot wait for us while holding it.
+	 */
+	mutex_lock(&owner->control);
+	if (!ret && atomic_read(&owner->closing))
+		ret = -ESHUTDOWN;
+	if (!ret && time_after_eq(jiffies, deadline))
+		ret = -ETIMEDOUT;
+	if (ret) {
+		if (!owner->error)
+			owner->error = ret;
+		hdd_pt_close_owner(owner, "00", 6);
+		hdd_pt_schedule(owner, 0);
+	} else {
+		owner->frequency = frequency;
+		smp_store_release(&owner->active, true);
+		/* A concurrent close always seals the gate, even if it races this
+		 * store. No packet may enter using active alone.
+		 */
+		if (atomic_read(&owner->closing)) {
+			smp_store_release(&owner->active, false);
+			ret = -ESHUTDOWN;
+		}
+	}
+	owner->channel_busy = false;
+	hdd_wh_leave(&ticket);
+unlock:
+	mutex_unlock(&owner->control);
+release:
+	hdd_pt_release(registry);
+	return ret;
+}
+
+int hdd_pt_with_active(struct hdd_pt_registry *registry, u64 generation,
+		       int (*operation)(struct wlan_objmgr_vdev *vdev,
+					u64 generation, void *context),
+		       void *context)
+{
+	struct hdd_pt_owner *owner;
+	struct hdd_wh_ticket ticket = {0};
+	struct wlan_objmgr_vdev *vdev = NULL;
+	int ret;
+
+	if (!operation || !generation)
+		return -EINVAL;
+	owner = hdd_pt_acquire(registry, generation);
+	if (!owner)
+		return -ENOENT;
+	mutex_lock(&owner->control);
+	if (owner->phase != HDD_PT_ACTIVE || !owner->vdev ||
+	    owner->channel_busy || atomic_read(&owner->closing)) {
+		ret = -ESHUTDOWN;
+	} else {
+		ret = hdd_wh_enter(&owner->gate, generation, &ticket);
+		if (!ret)
+			vdev = owner->vdev;
+	}
+	mutex_unlock(&owner->control);
+	if (!ret) {
+		ret = operation(vdev, generation, context);
+		hdd_wh_leave(&ticket);
+	}
+	hdd_pt_release(registry);
+	return ret;
+}
+
+int hdd_pt_activate(struct hdd_pt_registry *registry, u64 generation)
+{
+	struct hdd_pt_owner *owner = hdd_pt_acquire(registry, generation);
+	struct hdd_wh_ticket ticket = {0};
+	int ret = -ENOENT;
+
+	if (!owner)
+		return ret;
+	mutex_lock(&owner->control);
+	ret = hdd_wh_enter(&owner->gate, generation, &ticket);
+	if (!ret) {
+		if (owner->phase != HDD_PT_BOUND || atomic_read(&owner->closing)) {
+			ret = -EBUSY;
+		} else {
+			smp_store_release(&owner->active, true);
+			owner->phase = HDD_PT_ACTIVE;
+		}
+		hdd_wh_leave(&ticket);
+	}
+	mutex_unlock(&owner->control);
+	hdd_pt_release(registry);
+	return ret;
+}
+
+bool hdd_pt_data_ready(struct hdd_pt_registry *registry, u64 generation)
+{
+	struct hdd_pt_owner *owner = hdd_pt_acquire(registry, generation);
+	struct hdd_wh_ticket ticket = {0};
+	bool ready = false;
+
+	if (owner && !hdd_wh_enter(&owner->gate, generation, &ticket)) {
+		ready = smp_load_acquire(&owner->active);
+		hdd_wh_leave(&ticket);
+	}
+	if (owner)
+		hdd_pt_release(registry);
+	return ready;
+}
+
+#ifndef HOUJI_PT_OWNER_HOST_TEST
+netdev_tx_t hdd_pt_tx_net(struct hdd_pt_registry *registry, u64 generation,
+			  struct net_device *dev, struct sk_buff *skb)
+{
+	struct hdd_pt_owner *owner = hdd_pt_acquire(registry, generation);
+	struct hdd_wh_ticket ticket = {0};
+	enum cdp_pt_tx_status tx_st = CDP_PT_TX_DROP_VDEV;
+	struct sk_buff *rem = skb;
+	unsigned int pkt_len = skb ? skb->len : 0;
+
+	if (!skb) {
+		if (owner)
+			hdd_pt_release(registry);
+		return NETDEV_TX_OK;
+	}
+	if (owner && !hdd_wh_enter(&owner->gate, generation, &ticket)) {
+		if (smp_load_acquire(&owner->active) &&
+		    !atomic_read(&owner->closing)) {
+			rem = ucfg_dp_passthru_tx_status(owner->endpoint, skb,
+							 &tx_st);
+			if (!rem) {
+				hdd_pt_netstats_tx(registry, true, pkt_len);
+				hdd_wh_leave(&ticket);
+				hdd_pt_release(registry);
+				return NETDEV_TX_OK;
+			}
+			if ((tx_st == CDP_PT_TX_BUSY_DESC ||
+			     tx_st == CDP_PT_TX_BUSY_HW_ENQ) &&
+			    !qdf_nbuf_next(rem) &&
+			    READ_ONCE(pt_tx_backpressure) && dev &&
+			    netif_running(dev) &&
+			    !atomic_read(&owner->closing) &&
+			    smp_load_acquire(&owner->active) &&
+			    atomic_read(&owner->tx_wake_armed) != 2) {
+				int prev_wake;
+
+				netif_tx_stop_all_queues(dev);
+				smp_mb();
+				if (atomic_read(&owner->closing) ||
+				    !smp_load_acquire(&owner->active) ||
+				    !netif_running(dev) ||
+				    atomic_read(&owner->tx_wake_armed) == 2) {
+					netif_tx_wake_all_queues(dev);
+				} else {
+					prev_wake = atomic_cmpxchg(
+						&owner->tx_wake_armed, 0, 1);
+					if (prev_wake == 2) {
+						netif_tx_wake_all_queues(dev);
+					} else {
+						if (prev_wake == 0)
+							hrtimer_start(
+								&owner->tx_wake_timer,
+								ns_to_ktime(HDD_PT_TX_WAKE_US *
+									    NSEC_PER_USEC),
+								HRTIMER_MODE_REL_SOFT);
+						hdd_pt_tx_stat_inc(
+							tx_st == CDP_PT_TX_BUSY_DESC ?
+							HDD_PT_STAT_BUSY_DESC :
+							HDD_PT_STAT_BUSY_HW_ENQ);
+						hdd_pt_tx_stat_inc(
+							HDD_PT_STAT_REQUEUE);
+						hdd_wh_leave(&ticket);
+						hdd_pt_release(registry);
+						return NETDEV_TX_BUSY;
+					}
+				}
+			}
+			switch (tx_st) {
+			case CDP_PT_TX_DROP_VALIDATE:
+				hdd_pt_tx_stat_inc(HDD_PT_STAT_DROP_VALIDATE);
+				break;
+			case CDP_PT_TX_DROP_DMA:
+				hdd_pt_tx_stat_inc(HDD_PT_STAT_DROP_DMA);
+				break;
+			case CDP_PT_TX_BUSY_DESC:
+				hdd_pt_tx_stat_inc(HDD_PT_STAT_BUSY_DESC);
+				break;
+			case CDP_PT_TX_BUSY_HW_ENQ:
+				hdd_pt_tx_stat_inc(HDD_PT_STAT_BUSY_HW_ENQ);
+				break;
+			case CDP_PT_TX_DROP_VDEV:
+			default:
+				hdd_pt_tx_stat_inc(HDD_PT_STAT_DROP_VDEV);
+				break;
+			}
+		} else {
+			hdd_pt_tx_stat_inc(HDD_PT_STAT_INACTIVE);
+		}
+		hdd_wh_leave(&ticket);
+	} else {
+		hdd_pt_tx_stat_inc(HDD_PT_STAT_INACTIVE);
+	}
+	hdd_pt_netstats_tx(registry, false, 0);
+	hdd_pt_free_list(rem);
+	if (owner)
+		hdd_pt_release(registry);
+	return NETDEV_TX_OK;
+}
+#endif
+
+void hdd_pt_tx(struct hdd_pt_registry *registry, u64 generation,
+	       struct sk_buff *head)
+{
+	struct hdd_pt_owner *owner = hdd_pt_acquire(registry, generation);
+	struct hdd_wh_ticket ticket = {0};
+
+	if (owner && !hdd_wh_enter(&owner->gate, generation, &ticket)) {
+		if (smp_load_acquire(&owner->active))
+			head = ucfg_dp_passthru_tx(owner->endpoint, head);
+		hdd_wh_leave(&ticket);
+	}
+	hdd_pt_free_list(head);
+	if (owner)
+		hdd_pt_release(registry);
+}
+
+int hdd_pt_close(struct hdd_pt_registry *registry, u64 generation,
+		  const char country[3], unsigned int reason)
+{
+	struct hdd_pt_owner *owner;
+
+	if (!country)
+		return -EINVAL;
+	owner = hdd_pt_acquire(registry, generation);
+	if (!owner)
+		return -ENOENT;
+	hdd_pt_close_owner(owner, country, reason);
+	hdd_pt_schedule(owner, 0);
+	hdd_pt_release(registry);
+	return 0;
+}
+
+int hdd_pt_retire(struct hdd_pt_registry *registry, unsigned int reason)
+{
+	struct hdd_pt_owner *owner;
+
+	spin_lock_bh(&registry->lock);
+	registry->closed = true;
+	owner = registry->owner;
+	if (owner && !registry->reaping)
+		registry->users++;
+	else
+		owner = NULL;
+	spin_unlock_bh(&registry->lock);
+	if (owner) {
+		hdd_pt_close_owner(owner, "00", reason);
+		hdd_pt_schedule(owner, 0);
+		hdd_pt_release(registry);
+	}
+	return 0;
+}
+
+int hdd_pt_reap(struct hdd_pt_registry *registry)
+{
+	struct hdd_pt_owner *owner;
+
+	spin_lock_bh(&registry->lock);
+	owner = registry->owner;
+	if (!owner) {
+		spin_unlock_bh(&registry->lock);
+		return 0;
+	}
+	if (registry->reaping || READ_ONCE(owner->phase) != HDD_PT_DRAINED) {
+		spin_unlock_bh(&registry->lock);
+		return -EBUSY;
+	}
+	registry->reaping = true;
+	spin_unlock_bh(&registry->lock);
+	wait_event(registry->idle, !READ_ONCE(registry->users));
+	cancel_delayed_work_sync(&owner->work);
+	spin_lock_bh(&registry->lock);
+	registry->owner = NULL;
+	registry->reaping = false;
+	spin_unlock_bh(&registry->lock);
+	hdd_pt_put(owner);
+	return 0;
+}
+
+/* Post-CDS fences only. Unlike ordinary reap, this never waits for registry
+ * users or work while the caller may hold a driver transition and RTNL.
+ * Freeze already joined the worker; closed/reaping exclude new public users.
+ */
+int hdd_pt_recovery_reap(struct hdd_pt_registry *registry, u64 generation)
+{
+	struct hdd_pt_owner *owner;
+	struct hdd_pt_vdev_record *record;
+	struct hdd_wh_claim claim = {0};
+	enum hdd_wh_state state;
+	u32 required = HDD_PT_VDEV_DELETE_CALLED |
+		HDD_PT_VDEV_DELETE_RETURNED | HDD_PT_VDEV_HDD_REF_RELEASED |
+		HDD_PT_VDEV_SME_DELETE_CALLED | HDD_PT_VDEV_DELETE_WAIT_STARTED |
+		HDD_PT_VDEV_DELETE_WAIT_COMPLETED;
+	int ret = 0;
+
+	spin_lock_bh(&registry->lock);
+	if (registry->generation != generation) {
+		spin_unlock_bh(&registry->lock);
+		return -ESTALE;
+	}
+	if (!registry->closed || registry->reaping || registry->users) {
+		spin_unlock_bh(&registry->lock);
+		return -EBUSY;
+	}
+	owner = registry->owner;
+	if (!owner) {
+		spin_unlock_bh(&registry->lock);
+		return 0;
+	}
+	registry->reaping = true;
+	spin_unlock_bh(&registry->lock);
+	if (!mutex_trylock(&owner->control)) {
+		ret = -EBUSY;
+		goto retain;
+	}
+	if (!atomic_read(&owner->recovering) || !owner->recovery_prepared ||
+	    owner->vdev || owner->request || owner->endpoint ||
+	    refcount_read(&owner->refs) != 1) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	if (owner->phase != HDD_PT_DRAINED) {
+		if (owner->phase != HDD_PT_RECOVERING ||
+		    !owner->recovery_collected ||
+		    owner->pe_state != SME_PASSTHRU_SESSION_ABSENT) {
+			ret = -EBUSY;
+			goto unlock;
+		}
+		record = owner->record;
+		if (!record || record->generation != generation ||
+		    record->link != owner->link ||
+		    record->vdev_id != owner->vdev_id) {
+			ret = -EUCLEAN;
+			goto unlock;
+		}
+		/* This narrow finish accepts the completed ordinary delete path.
+		 * A timeout, vanished ID, or successful WMA parameter reap alone
+		 * is not that proof. Keep ambiguous recovery objects for a later,
+		 * explicitly joined objmgr completion route.
+		 */
+		if (!owner->detach_attempted || owner->detach_error ||
+		    (record->steps & required) != required ||
+		    (record->steps & HDD_PT_VDEV_DELETE_WAIT_TIMED_OUT) ||
+		    record->delete_result ||
+		    QDF_IS_STATUS_ERROR(record->sme_delete_status)) {
+			ret = -EBUSY;
+			goto unlock;
+		}
+	}
+	spin_lock_bh(&owner->gate.lock);
+	state = owner->gate.state;
+	if (owner->gate.generation != generation ||
+	    owner->gate.users || owner->gate.actor)
+		ret = -EBUSY;
+	if (!ret && owner->phase == HDD_PT_DRAINED &&
+	    (state != HDD_WH_RELEASED || owner->gate.sink))
+		ret = -EUCLEAN;
+	spin_unlock_bh(&owner->gate.lock);
+	if (ret)
+		goto unlock;
+	if (state == HDD_WH_CLOSING) {
+		ret = hdd_wh_try_claim(&owner->gate, generation, &claim);
+		if (ret)
+			goto unlock;
+		ret = hdd_wh_finish(&claim, true);
+		if (ret)
+			goto unlock;
+		state = HDD_WH_DRAINED;
+	}
+	if (state == HDD_WH_DRAINED) {
+#ifndef HOUJI_PT_OWNER_HOST_TEST
+		atomic_set(&owner->tx_wake_armed, 2);
+		hrtimer_cancel(&owner->tx_wake_timer);
+#endif
+		ret = hdd_wh_release(&owner->gate);
+		if (ret)
+			goto unlock;
+	} else if (state != HDD_WH_RELEASED) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	owner->phase = HDD_PT_DRAINED;
+	mutex_unlock(&owner->control);
+	spin_lock_bh(&registry->lock);
+	registry->owner = NULL;
+	registry->reaping = false;
+	spin_unlock_bh(&registry->lock);
+	hdd_pt_put(owner);
+	return 0;
+unlock:
+	mutex_unlock(&owner->control);
+retain:
+	spin_lock_bh(&registry->lock);
+	registry->reaping = false;
+	spin_unlock_bh(&registry->lock);
+	return ret;
+}
diff --git a/qcacld-3.0/core/hdd/src/wlan_hdd_passthru_runtime.c b/qcacld-3.0/core/hdd/src/wlan_hdd_passthru_runtime.c
