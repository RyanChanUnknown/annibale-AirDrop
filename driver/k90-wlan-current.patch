+static int wma_pt_fw_caps_get(char *buf, const struct kernel_param *kp)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	target_resource_config *cfg;
+	bool svc_338, create_conf, sync_del;
+	u32 max_peers = 0;
+	u32 ext2_len = 0, ext2_w7 = 0;
+	bool wire_506_valid = false;
+	wmi_unified_t wmi;
+
+	(void)kp;
+	if (!wma || !wma->wmi_handle || !wma->psoc)
+		return scnprintf(buf, PAGE_SIZE,
+				 "ready=0 wmi_service_338_passthru_ampdu=0 peer_create_conf=0 sync_delete=0 max_peers=0\n");
+	cfg = lmac_get_tgt_res_cfg(wma->psoc);
+	if (cfg)
+		max_peers = cfg->num_peers;
+	wmi = wma->wmi_handle;
+	if (wmi->soc) {
+		ext2_len = wmi->soc->wmi_ext2_service_bitmap_len;
+		wire_506_valid = ext2_len > 7 &&
+			wmi->soc->wmi_ext2_service_bitmap;
+		if (wire_506_valid)
+			ext2_w7 = wmi->soc->wmi_ext2_service_bitmap[7];
+	}
+	svc_338 = wmi_service_enabled(wma->wmi_handle,
+				      WMA_WMI_SERVICE_PASSTHRU_AMPDU_SUPPORT);
+	create_conf = wmi_service_enabled(wma->wmi_handle,
+					  wmi_service_peer_create_conf);
+	sync_del = wmi_service_enabled(wma->wmi_handle,
+				       wmi_service_sync_delete_cmds);
+	return scnprintf(buf, PAGE_SIZE,
+			 "ready=1 wire_506_valid=%u wire_506_passthru_ampdu=%u ext2_len_words=%u ext2_w7=0x%08x wmi_service_338_passthru_ampdu=%u peer_create_conf=%u sync_delete=%u max_peers=%u\n",
+			 wire_506_valid, !!(ext2_w7 & BIT(26)), ext2_len, ext2_w7,
+			 svc_338 ? 1 : 0, create_conf ? 1 : 0,
+			 sync_del ? 1 : 0, max_peers);
+}
+
+static const struct kernel_param_ops wma_pt_fw_caps_ops = {
+	.get = wma_pt_fw_caps_get,
+};
+module_param_cb(pt_fw_caps, &wma_pt_fw_caps_ops, NULL, 0400);
+
+static int wma_pt_remote_peer_stats_get(char *buf, const struct kernel_param *kp)
+{
+	struct wma_pt_peer_state s;
+
+	(void)kp;
+	wma_pt_peer_snapshot(&s);
+	return scnprintf(buf, PAGE_SIZE,
+			 "active=%u generation=%llu vdev=%u peer_id=%u ast_valid=%u "
+			 "ast_idx=%u ast_hash=%u reo_enabled=%u is_2ss=%u "
+			 "obj_created=%u dp_created=%u create_confirm=%u create_status=%u "
+			 "htt_map=%u slot=%u reo_setup=%u reo_status=%u "
+			 "assoc_issued=%u assoc_confirm=%u assoc_status=%u tx_ready=%u "
+			 "delete_issued=%u delete_confirm=%u htt_unmap=%u slot_removed=%u "
+			 "dp_released=%u obj_released=%u dp_conflict=%u "
+			 "setup_rc=%d teardown_rc=%d\n",
+			 s.active, s.generation, s.vdev_id, s.peer_id, s.ast_valid,
+			 s.ast_idx, s.ast_hash, s.reo_enabled, s.is_2ss,
+			 s.obj_created, s.dp_created, s.create_confirmed, s.create_status,
+			 s.htt_map, s.slot_installed, s.reo_setup, s.reo_status,
+			 s.assoc_issued, s.assoc_confirmed, s.assoc_status, s.tx_ready,
+			 s.delete_issued, s.delete_confirmed, s.htt_unmap, s.slot_removed,
+			 s.dp_released, s.obj_released, s.dp_conflict,
+			 s.setup_rc, s.teardown_rc);
+}
+
+static const struct kernel_param_ops wma_pt_remote_peer_stats_ops = {
+	.get = wma_pt_remote_peer_stats_get,
+};
+module_param_cb(pt_remote_peer_stats, &wma_pt_remote_peer_stats_ops, NULL, 0400);
