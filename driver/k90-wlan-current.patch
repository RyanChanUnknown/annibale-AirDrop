+static bool wma_pt_peer_create_event(tp_wma_handle wma, u32 vdev_id,
+				     const u8 *mac, u32 status)
+{
+	struct wma_pt_peer_state *slot;
+	unsigned long flags;
+	bool matched = false;
+
+	if (!READ_ONCE(wma_pt_peer_seq))
+		return false;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot = wma_pt_find_slot_wma(wma, vdev_id, mac);
+	if (slot && slot->create_issued) {
+		matched = true;
+		if (!slot->create_confirmed) {
+			slot->create_status = status;
+			slot->create_confirmed = true;
+		}
+	}
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return matched;
+}
+
+static bool wma_pt_peer_assoc_event(tp_wma_handle wma, u32 vdev_id,
+				    const u8 *mac, u32 status)
+{
+	struct wma_pt_peer_state *slot;
+	unsigned long flags;
+	bool matched = false;
+
+	if (!READ_ONCE(wma_pt_peer_seq))
+		return false;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot = wma_pt_find_slot_wma(wma, vdev_id, mac);
+	if (slot && slot->assoc_issued) {
+		matched = true;
+		if (!slot->assoc_confirmed) {
+			slot->assoc_status = status;
+			slot->assoc_confirmed = true;
+		}
+	}
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return matched;
+}
+
+static bool wma_pt_peer_delete_event(tp_wma_handle wma, u32 vdev_id,
+				     const u8 *mac, bool *first, u64 *peer_seq)
+{
+	struct wma_pt_peer_state *slot;
+	unsigned long flags;
+	bool matched = false;
+
+	*first = false;
+	*peer_seq = 0;
+	if (!READ_ONCE(wma_pt_peer_seq))
+		return false;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot = wma_pt_find_slot_wma(wma, vdev_id, mac);
+	if (slot && slot->delete_issued) {
+		matched = true;
+		if (!slot->delete_claimed) {
+			slot->delete_claimed = true;
+			*first = true;
+			*peer_seq = slot->peer_seq;
+		}
+	}
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return matched;
+}
+
+static void wma_pt_peer_delete_confirm(u64 peer_seq)
+{
+	struct wma_pt_peer_state *slot;
+	unsigned long flags;
+
+	if (!peer_seq)
+		return;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot = wma_pt_find_slot_seq(peer_seq);
+	if (slot)
+		slot->delete_confirmed = true;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+}
+
+void pt_remote_peer_dp_event(const void *psoc, u8 vdev_id, const u8 *mac,
+			     u16 peer_id, enum pt_remote_peer_event event)
+{
+	struct wma_pt_peer_state *slot;
+	unsigned long flags;
+
+	if (!READ_ONCE(wma_pt_peer_seq))
+		return;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot = wma_pt_find_slot_dp(psoc, vdev_id, mac);
+	if (!slot)
+		goto unlock;
+
+	if (!slot->create_issued || peer_id == U16_MAX ||
+	    (slot->htt_map && slot->peer_id != peer_id)) {
+		slot->dp_conflict = true;
+		goto unlock;
+	}
+
+	switch (event) {
+	case PT_REMOTE_HTT_MAP:
+		if (slot->htt_unmap || slot->slot_removed)
+			slot->dp_conflict = true;
+		slot->htt_map = true;
+		slot->peer_id = peer_id;
+		break;
+	case PT_REMOTE_SLOT_INSTALL:
+		if (!slot->htt_map || slot->htt_unmap)
+			slot->dp_conflict = true;
+		else
+			slot->slot_installed = true;
+		break;
+	case PT_REMOTE_HTT_UNMAP:
+		if (!slot->delete_issued || !slot->slot_installed)
+			slot->dp_conflict = true;
+		else
+			slot->htt_unmap = true;
+		break;
+	case PT_REMOTE_SLOT_REMOVE:
+		if (!slot->delete_issued || !slot->slot_installed)
+			slot->dp_conflict = true;
+		else
+			slot->slot_removed = true;
+		break;
+	}
+unlock:
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+}
+
+void pt_remote_peer_set_ast(const void *psoc, u8 vdev_id, const u8 *mac,
+			    u16 peer_id, u16 ast_idx, u16 ast_hash)
+{
+	struct wma_pt_peer_state *slot;
+	unsigned long flags;
+
+	if (!READ_ONCE(wma_pt_peer_seq))
+		return;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot = wma_pt_find_slot_dp(psoc, vdev_id, mac);
+	if (slot && peer_id != U16_MAX && ast_idx != U16_MAX) {
+		slot->peer_id = peer_id;
+		slot->ast_idx = ast_idx;
+		slot->ast_hash = ast_hash;
+		slot->ast_valid = true;
+		wma_pt_sync_fast_locked(slot);
+	}
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+}
+
+static inline u32 wma_pt_fast_read_begin(void)
+{
+	u32 seq;
+
+	while (unlikely((seq = READ_ONCE(wma_pt_fast_seq)) & 1U))
+		cpu_relax();
+	smp_rmb();
+	return seq;
+}
+
+static inline bool wma_pt_fast_read_retry(u32 seq)
+{
+	smp_rmb();
+	return unlikely(READ_ONCE(wma_pt_fast_seq) != seq);
+}
+
+bool pt_remote_peer_lookup_ast(const void *psoc, u8 vdev_id, const u8 *ra_mac,
+			       u16 *ast_idx, u16 *ast_hash)
+{
+	u32 seq;
+	bool ok;
+	u16 idx_out, hash_out;
+	int i;
+
+	if (atomic_read(&wma_pt_tx_ready_count) <= 0)
+		return false;
+
+	do {
+		seq = wma_pt_fast_read_begin();
+		ok = false;
+		idx_out = 0;
+		hash_out = 0;
+		for (i = 0; i < WMA_PT_MAX_PEERS; i++) {
+			const struct wma_pt_fast_slot *s = &wma_pt_fast_slots[i];
+
+			if (s->ready && s->ast_valid &&
+			    s->psoc == psoc && s->vdev_id == vdev_id &&
+			    !memcmp(s->mac, ra_mac, QDF_MAC_ADDR_SIZE)) {
+				idx_out = s->ast_idx;
+				hash_out = s->ast_hash;
+				ok = true;
+				break;
+			}
+		}
+	} while (wma_pt_fast_read_retry(seq));
+
+	if (ok) {
+		*ast_idx = idx_out;
+		*ast_hash = hash_out;
+	}
+	return ok;
+}
+
+u16 pt_remote_peer_active_id(void)
+{
+	unsigned long flags;
+	u16 id = U16_MAX;
+	int i;
+
+	if (atomic_read(&wma_pt_tx_ready_count) <= 0)
+		return U16_MAX;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	for (i = 0; i < WMA_PT_MAX_PEERS; i++) {
+		if (wma_pt_peers[i].peer_seq && wma_pt_peers[i].tx_ready &&
+		    wma_pt_peers[i].peer_id != U16_MAX) {
+			id = wma_pt_peers[i].peer_id;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return id;
+}
+
+bool pt_remote_peer_is_active_id(u16 peer_id)
+{
+	u32 seq;
+	bool active;
+	int i;
+
+	if (peer_id == U16_MAX || atomic_read(&wma_pt_tx_ready_count) <= 0)
+		return false;
+
+	if (likely(peer_id < WMA_PT_PEER_BITMAP_BITS)) {
+		smp_rmb();
+		return !!(READ_ONCE(wma_pt_active_peer_words[peer_id >> 6]) &
+			  BIT_ULL(peer_id & 63));
+	}
+
+	do {
+		seq = wma_pt_fast_read_begin();
+		active = false;
+		for (i = 0; i < WMA_PT_MAX_PEERS; i++) {
+			if (wma_pt_fast_slots[i].ready &&
+			    wma_pt_fast_slots[i].peer_id == peer_id) {
+				active = true;
+				break;
+			}
+		}
+	} while (wma_pt_fast_read_retry(seq));
+	return active;
+}
+
+u64 pt_remote_peer_release_key(const void *psoc, u8 vdev_id, const u8 *mac)
+{
+	struct wma_pt_peer_state *slot;
+	unsigned long flags;
+	u64 peer_seq = 0;
+
+	if (!READ_ONCE(wma_pt_peer_seq))
+		return 0;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot = wma_pt_find_slot_dp(psoc, vdev_id, mac);
+	if (slot)
+		peer_seq = slot->peer_seq;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return peer_seq;
+}
+
+void pt_remote_peer_released(u64 peer_seq, enum pt_remote_peer_object obj)
+{
+	struct wma_pt_peer_state *slot;
+	unsigned long flags;
+
+	if (!peer_seq)
+		return;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot = wma_pt_find_slot_seq(peer_seq);
+	if (slot) {
+		if (slot->create_issued && !slot->delete_issued)
+			slot->dp_conflict = true;
+		if (obj == PT_REMOTE_DP_OBJECT)
+			slot->dp_released = true;
+		else
+			slot->obj_released = true;
+	}
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+}
+
+static void wma_pt_peer_snapshot(struct wma_pt_peer_state *out)
+{
+	unsigned long flags;
+	bool found = false;
+	int i;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	for (i = 0; i < WMA_PT_MAX_PEERS; i++) {
+		if (wma_pt_peers[i].peer_seq) {
+			*out = wma_pt_peers[i];
+			found = true;
+			break;
+		}
+	}
+	if (!found)
+		*out = wma_pt_peer_last;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+}
+
+/* Caller holds wma_pt_peer_ops_lock. */
+static int wma_pt_remote_peer_del_slot_locked(tp_wma_handle wma,
+					      struct wlan_objmgr_vdev *vdev,
+					      struct wma_pt_peer_state *slot)
+{
+	struct wma_pt_peer_state snap;
+	u8 remote_mac[QDF_MAC_ADDR_SIZE];
+	unsigned long flags, deadline;
+	QDF_STATUS status;
+	u64 peer_seq;
+	u8 vdev_id;
+	bool no_fw_del;
+	bool done;
+	int rc = -ETIMEDOUT;
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	if (!slot->peer_seq) {
+		spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+		return 0;
+	}
+	wma_pt_set_tx_ready_locked(slot, false);
+	peer_seq = slot->peer_seq;
+	vdev_id = slot->vdev_id;
+	memcpy(remote_mac, slot->mac, QDF_MAC_ADDR_SIZE);
+	if (!slot->create_issued) {
+		slot->teardown_rc = 0;
+		wma_pt_clear_slot_locked(slot);
+		spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+		return 0;
+	}
+	if (!wma || !vdev || vdev_id >= wma->max_bssid ||
+	    wma->interfaces[vdev_id].vdev != vdev ||
+	    slot->delete_issued) {
+		slot->teardown_rc = -EINVAL;
+		wma_pt_peer_last = *slot;
+		spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+		return -EINVAL;
+	}
+	no_fw_del = QDF_IS_STATUS_ERROR(slot->create_submit) ||
+		    (slot->create_confirmed && slot->create_status != 0);
+	slot->delete_issued = true;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	smp_mb();
+
+	status = wma_remove_peer(wma, remote_mac, vdev_id, no_fw_del);
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot->delete_submit = status;
+	slot->delete_returned = true;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		rc = qdf_status_to_os_return(status);
+		goto out;
+	}
+
+	deadline = jiffies + msecs_to_jiffies(WMA_PT_PEER_WAIT_MS);
+	do {
+		if (cds_is_driver_recovering()) {
+			rc = -ESHUTDOWN;
+			break;
+		}
+		spin_lock_irqsave(&wma_pt_peer_lock, flags);
+		snap = *slot;
+		spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+		if (snap.dp_conflict) {
+			rc = -EIO;
+			break;
+		}
+		if (snap.slot_installed)
+			done = snap.delete_confirmed && snap.htt_unmap &&
+			       snap.slot_removed && snap.dp_released &&
+			       snap.obj_released;
+		else if (no_fw_del)
+			done = snap.dp_released && snap.obj_released;
+		else
+			done = snap.delete_confirmed && snap.dp_released &&
+			       snap.obj_released;
+		if (done) {
+			rc = 0;
+			break;
+		}
+		usleep_range(2000, 4000);
+	} while (time_before(jiffies, deadline));
+
+out:
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot = wma_pt_find_slot_seq(peer_seq);
+	if (slot) {
+		slot->teardown_rc = rc;
+		if (rc == 0) {
+			wma_pt_clear_slot_locked(slot);
+		} else {
+			slot->active = true;
+			wma_pt_peer_last = *slot;
+		}
+	}
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	return rc;
+}
+
+static int wma_pt_remote_peer_clear_locked(struct wlan_objmgr_vdev *vdev,
+					   u64 generation, bool reset_reo)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	unsigned long flags;
+	int i, ret, rc = 0;
+	u8 vdev_id = WLAN_INVALID_VDEV_ID;
+	bool had_slot = false;
+
+	if (!generation) {
+		if (reset_reo)
+			WRITE_ONCE(pt_reo_mode, 0);
+		return 0;
+	}
+
+	for (i = 0; i < WMA_PT_MAX_PEERS; i++) {
+		bool match;
+
+		spin_lock_irqsave(&wma_pt_peer_lock, flags);
+		match = wma_pt_peers[i].peer_seq &&
+			wma_pt_peers[i].generation == generation;
+		if (match && vdev_id == WLAN_INVALID_VDEV_ID)
+			vdev_id = wma_pt_peers[i].vdev_id;
+		spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+		if (!match)
+			continue;
+
+		had_slot = true;
+		ret = wma_pt_remote_peer_del_slot_locked(wma, vdev,
+							 &wma_pt_peers[i]);
+		if (ret && !rc)
+			rc = ret;
+	}
+
+	if (reset_reo) {
+		if (!rc && had_slot && wma && vdev_id < wma->max_bssid &&
+		    wma->interfaces[vdev_id].peer_count != 1)
+			rc = -EIO;
+		if (!rc)
+			WRITE_ONCE(pt_reo_mode, 0);
+	}
+	return rc;
+}
+
+int wma_pt_remote_peer_clear(struct wlan_objmgr_vdev *vdev, u64 generation)
+{
+	int rc;
+
+	mutex_lock(&wma_pt_peer_ops_lock);
+	rc = wma_pt_remote_peer_clear_locked(vdev, generation, false);
+	mutex_unlock(&wma_pt_peer_ops_lock);
+	return rc;
+}
+
+int wma_pt_remote_peer_teardown(struct wlan_objmgr_vdev *vdev, u64 generation)
+{
+	int rc;
+
+	mutex_lock(&wma_pt_peer_ops_lock);
+	rc = wma_pt_remote_peer_clear_locked(vdev, generation, true);
+	mutex_unlock(&wma_pt_peer_ops_lock);
+	return rc;
+}
+
+int wma_pt_remote_peer_del(struct wlan_objmgr_vdev *vdev, u64 generation,
+			   const u8 *remote_mac)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct wma_pt_peer_state *slot = NULL;
+	unsigned long flags;
+	u8 vdev_id;
+	int i, rc = 0;
+
+	if (!generation || !vdev || !wma_is_passthru_vdev(vdev) || !remote_mac)
+		return -EINVAL;
+
+	vdev_id = wlan_vdev_get_id(vdev);
+
+	mutex_lock(&wma_pt_peer_ops_lock);
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	for (i = 0; i < WMA_PT_MAX_PEERS; i++) {
+		struct wma_pt_peer_state *s = &wma_pt_peers[i];
+
+		if (s->peer_seq && s->generation == generation &&
+		    s->vdev_id == vdev_id &&
+		    !memcmp(s->mac, remote_mac, QDF_MAC_ADDR_SIZE)) {
+			slot = s;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	if (slot)
+		rc = wma_pt_remote_peer_del_slot_locked(wma, vdev, slot);
+	mutex_unlock(&wma_pt_peer_ops_lock);
+	return rc;
+}
+
+u32 pt_remote_peer_reo_mode(void)
+{
+	return READ_ONCE(pt_reo_mode);
+}
+
+void pt_remote_peer_set_reo_mode(u32 mode)
+{
+	WRITE_ONCE(pt_reo_mode, mode);
+}
+
+static void wma_pt_normalize_caps(struct wma_pt_peer_caps *dst,
+				  const struct wma_pt_peer_caps *src)
+{
+	bool legacy_sgi;
+	bool legacy_ldpc;
+
+	memset(dst, 0, sizeof(*dst));
+	if (!src || (!src->ht && !src->vht)) {
+		dst->nss = 1;
+		dst->bw = 20;
+		dst->max_mcs = 7;
+		dst->max_mpdu = 3895;
+		return;
+	}
+	dst->vht = src->vht;
+	dst->ht = src->ht || src->vht;
+	dst->nss = (src->nss >= 2) ? 2 : 1;
+	if (dst->vht) {
+		if (src->bw >= 80)
+			dst->bw = 80;
+		else if (src->bw >= 40)
+			dst->bw = 40;
+		else
+			dst->bw = 20;
+		if (src->max_mcs >= 9)
+			dst->max_mcs = 9;
+		else if (src->max_mcs == 8)
+			dst->max_mcs = 8;
+		else
+			dst->max_mcs = 7;
+		if (dst->bw == 20 && dst->max_mcs > 8)
+			dst->max_mcs = 8;
+	} else {
+		dst->bw = (src->bw >= 40) ? 40 : 20;
+		dst->max_mcs = 7;
+	}
+
+	dst->has_ht_bw40 = true;
+	dst->ht_bw40 = dst->ht && (src->has_ht_bw40 ? src->ht_bw40 : (dst->bw >= 40));
+
+	legacy_sgi = src->sgi;
+	legacy_ldpc = src->ldpc;
+
+	dst->has_ht_sgi20 = true;
+	dst->ht_sgi20 = dst->ht && (src->has_ht_sgi20 ? src->ht_sgi20 : legacy_sgi);
+	dst->has_ht_sgi40 = true;
+	dst->ht_sgi40 = dst->ht && dst->ht_bw40 &&
+			(src->has_ht_sgi40 ? src->ht_sgi40 : legacy_sgi);
+	dst->has_vht_sgi80 = true;
+	dst->vht_sgi80 = dst->vht && dst->bw >= 80 &&
+			 (src->has_vht_sgi80 ? src->vht_sgi80 : legacy_sgi);
+
+	dst->has_ht_ldpc = true;
+	dst->ht_ldpc = dst->ht && (src->has_ht_ldpc ? src->ht_ldpc : legacy_ldpc);
+	dst->has_vht_ldpc = true;
+	dst->vht_ldpc = dst->vht && (src->has_vht_ldpc ? src->vht_ldpc : legacy_ldpc);
+
+	if (dst->vht) {
+		if (dst->bw >= 80)
+			dst->sgi = dst->vht_sgi80;
+		else if (dst->bw >= 40)
+			dst->sgi = src->has_ht_sgi40 ? dst->ht_sgi40 : legacy_sgi;
+		else
+			dst->sgi = src->has_ht_sgi20 ? dst->ht_sgi20 : legacy_sgi;
+		dst->ldpc = dst->vht_ldpc;
+	} else {
+		dst->sgi = (dst->bw >= 40) ? dst->ht_sgi40 : dst->ht_sgi20;
+		dst->ldpc = dst->ht_ldpc;
+	}
+
+	if (src->max_mpdu >= 11454)
+		dst->max_mpdu = 11454;
+	else if (src->max_mpdu >= 7991)
+		dst->max_mpdu = 7991;
+	else
+		dst->max_mpdu = 3895;
+	dst->has_ampdu_exp = src->has_ampdu_exp;
+	if (src->has_ampdu_exp)
+		dst->ampdu_exp = min_t(u8, src->ampdu_exp, dst->vht ? 7U : 3U);
+	else
+		dst->ampdu_exp = dst->vht ? 7U : 3U;
+	dst->mpdu_density = min_t(u8, src->mpdu_density, 7U);
+	dst->ht_mcs_mask = src->ht_mcs_mask;
+}
+
+static void wma_pt_default_caps(struct wma_pt_peer_caps *dst, bool is_2ss)
+{
+	memset(dst, 0, sizeof(*dst));
+	dst->ht = true;
+	dst->vht = true;
+	dst->nss = is_2ss ? 2 : 1;
+	dst->bw = 80;
+	dst->max_mcs = 9;
+	dst->sgi = true;
+	dst->ldpc = true;
+	dst->has_ht_bw40 = true;
+	dst->ht_bw40 = true;
+	dst->has_ht_sgi20 = true;
+	dst->ht_sgi20 = true;
+	dst->has_ht_sgi40 = true;
+	dst->ht_sgi40 = true;
+	dst->has_ht_ldpc = true;
+	dst->ht_ldpc = true;
+	dst->has_vht_sgi80 = true;
+	dst->vht_sgi80 = true;
+	dst->has_vht_ldpc = true;
+	dst->vht_ldpc = true;
+	dst->max_mpdu = 3895;
+	dst->has_ampdu_exp = false;
+	dst->ampdu_exp = 7;
+	dst->mpdu_density = 0;
+	dst->ht_mcs_mask = is_2ss ? 0xffffU : 0x00ffU;
+}
+
+static u16 wma_pt_vht_mcs_map(u8 nss, u8 max_mcs)
+{
+	u16 code = (max_mcs >= 9) ? 2 : ((max_mcs == 8) ? 1 : 0);
+	u16 map = 0xffff;
+	u8 s;
+
+	for (s = 0; s < nss && s < 2; s++) {
+		map &= ~(0x3U << (s * 2));
+		map |= (code << (s * 2));
+	}
+	return map;
+}
+
+static u16 wma_pt_vht_max_rate(const struct wma_pt_peer_caps *caps)
+{
+	bool sgi;
+
+	if (!caps->vht)
+		return 0;
+	if (caps->bw >= 80) {
+		sgi = caps->vht_sgi80;
+		if (caps->nss >= 2) {
+			if (caps->max_mcs >= 9)
+				return sgi ? 867 : 780;
+			if (caps->max_mcs == 8)
+				return sgi ? 780 : 702;
+			return sgi ? 650 : 585;
+		}
+		if (caps->max_mcs >= 9)
+			return sgi ? 433 : 390;
+		if (caps->max_mcs == 8)
+			return sgi ? 390 : 351;
+		return sgi ? 325 : 293;
+	}
+	if (caps->bw >= 40) {
+		sgi = caps->ht_sgi40;
+		if (caps->nss >= 2)
+			return (caps->max_mcs >= 9) ? (sgi ? 400 : 360) :
+						      (sgi ? 300 : 270);
+		return (caps->max_mcs >= 9) ? (sgi ? 200 : 180) :
+					      (sgi ? 150 : 135);
+	}
+	sgi = caps->ht_sgi20;
+	if (caps->nss >= 2)
+		return (caps->max_mcs >= 8) ? (sgi ? 173 : 156) :
+					      (sgi ? 144 : 130);
+	return (caps->max_mcs >= 8) ? (sgi ? 87 : 78) :
+				      (sgi ? 72 : 65);
+}
+
+static enum wlan_phymode
+wma_pt_caps_phymodes(const struct wma_pt_peer_caps *caps, u32 *wmi_mode)
+{
+	if (caps->vht && caps->bw >= 80) {
+		*wmi_mode = WMI_HOST_MODE_11AC_VHT80;
+		return WLAN_PHYMODE_11AC_VHT80;
+	}
+	if (caps->vht && caps->bw >= 40) {
+		*wmi_mode = WMI_HOST_MODE_11AC_VHT40;
+		return WLAN_PHYMODE_11AC_VHT40;
+	}
+	if (caps->vht) {
+		*wmi_mode = WMI_HOST_MODE_11AC_VHT20;
+		return WLAN_PHYMODE_11AC_VHT20;
+	}
+	if (caps->ht && caps->bw >= 40) {
+		*wmi_mode = WMI_HOST_MODE_11NA_HT40;
+		return WLAN_PHYMODE_11NA_HT40;
+	}
+	if (caps->ht) {
+		*wmi_mode = WMI_HOST_MODE_11NA_HT20;
+		return WLAN_PHYMODE_11NA_HT20;
+	}
+	*wmi_mode = WMI_HOST_MODE_11A;
+	return WLAN_PHYMODE_11A;
+}
+
+static u32 wma_pt_mpdu_density_us(u8 code)
+{
+	static const u8 tbl[8] = { 0, 1, 1, 1, 2, 4, 8, 16 };
+
+	return tbl[code & 0x07U];
+}
+
+static void wma_pt_fill_assoc_params(struct peer_assoc_params *assoc,
+				     const u8 *remote_mac, u8 vdev_id,
+				     u8 slot_idx,
+				     const struct wma_pt_peer_caps *caps)
+{
+	static const u8 legacy_11a[8] = {12, 18, 24, 36, 48, 72, 96, 108};
+	bool is_2ss = caps->nss >= 2;
+	u32 wmi_phymode = WMI_HOST_MODE_11A;
+	u32 vht_mpdu_code;
+	u8 vht_ampdu_exp;
+	u16 ht_mask;
+	u8 max_ht_rates;
+	u8 ht_num_rates = 0;
+	u16 vht_mcs_map;
+	u16 max_rate;
+	int i;
+
+	memset(assoc, 0, sizeof(*assoc));
+	memcpy(assoc->peer_mac, remote_mac, QDF_MAC_ADDR_SIZE);
+	assoc->vdev_id = vdev_id;
+	assoc->peer_new_assoc = 1;
+	assoc->peer_associd = slot_idx + 1;
+	assoc->peer_caps = 0x0421;
+	assoc->peer_listen_intval = 1;
+	assoc->is_wme_set = 1;
+	assoc->qos_flag = 1;
+	assoc->auth_flag = 1;
+	assoc->ht_flag = caps->ht ? 1 : 0;
+	assoc->vht_flag = caps->vht ? 1 : 0;
+	assoc->vht_capable = caps->vht ? 1 : 0;
+	assoc->bw_40 = (caps->bw >= 40) ? 1 : 0;
+	assoc->bw_80 = (caps->vht && caps->bw >= 80) ? 1 : 0;
+	assoc->ldpc_flag = caps->ldpc ? 1 : 0;
+	assoc->spatial_mux_flag = is_2ss ? 1 : 0;
+	assoc->peer_rate_caps = (caps->ht ? WMI_RC_HT_FLAG : 0) |
+				(caps->bw >= 40 ? WMI_RC_CW40_FLAG : 0) |
+				(caps->sgi ? WMI_RC_SGI_FLAG : 0) |
+				(is_2ss ? WMI_RC_DS_FLAG : 0);
+	if (caps->ht) {
+		assoc->peer_ht_caps = 0x018c |
+				      (caps->ht_ldpc ? 0x0001 : 0) |
+				      (caps->ht_bw40 ? 0x0002 : 0) |
+				      (caps->ht_sgi20 ? 0x0020 : 0) |
+				      ((caps->ht_sgi40 && caps->ht_bw40) ? 0x0040 : 0);
+	}
+	if (caps->has_ampdu_exp)
+		assoc->peer_max_mpdu =
+			(1U << (13U + min_t(u8, caps->ampdu_exp,
+					    caps->vht ? 7U : 3U))) - 1U;
+	else
+		assoc->peer_max_mpdu = 65535U;
+	assoc->peer_mpdu_density = wma_pt_mpdu_density_us(caps->mpdu_density);
+	assoc->peer_nss = is_2ss ? 2 : 1;
+	wma_pt_caps_phymodes(caps, &wmi_phymode);
+	assoc->peer_phymode = wmi_phymode;
+	if (caps->vht) {
+		vht_mcs_map = wma_pt_vht_mcs_map(assoc->peer_nss,
+						 caps->max_mcs);
+		max_rate = wma_pt_vht_max_rate(caps);
+		vht_mpdu_code = (caps->max_mpdu >= 11454) ? 2U :
+				((caps->max_mpdu >= 7991) ? 1U : 0U);
+		vht_ampdu_exp = caps->has_ampdu_exp ?
+				min_t(u8, caps->ampdu_exp, 7U) : 7U;
+		assoc->peer_vht_caps = ((u32)vht_ampdu_exp << 23) |
+				       vht_mpdu_code |
+				       (caps->vht_ldpc ? 0x00000010U : 0U) |
+				       ((caps->vht_sgi80 && caps->bw >= 80) ? 0x00000020U : 0U);
+		assoc->rx_max_rate = max_rate;
+		assoc->rx_mcs_set = vht_mcs_map;
+		assoc->tx_max_rate = max_rate;
+		assoc->tx_mcs_set = vht_mcs_map;
+	}
+	assoc->peer_legacy_rates.num_rates = sizeof(legacy_11a);
+	memcpy(assoc->peer_legacy_rates.rates, legacy_11a, sizeof(legacy_11a));
+	if (caps->ht) {
+		max_ht_rates = is_2ss ? 16 : 8;
+		ht_mask = caps->ht_mcs_mask ? caps->ht_mcs_mask :
+			  (is_2ss ? 0xffffU : 0x00ffU);
+		for (i = 0; i < max_ht_rates; i++) {
+			if (ht_mask & BIT(i))
+				assoc->peer_ht_rates.rates[ht_num_rates++] = i;
+		}
+	}
+	assoc->peer_ht_rates.num_rates = ht_num_rates;
+}
+
+int wma_pt_remote_peer_add_caps(struct wlan_objmgr_vdev *vdev, u64 generation,
+				const u8 *remote_mac, u32 enable_reo,
+				const struct wma_pt_peer_caps *raw_caps)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	void *soc = cds_get_context(QDF_MODULE_ID_SOC);
+	struct peer_create_params cparam = {0};
+	struct peer_assoc_params assoc;
+	struct wma_pt_peer_caps caps;
+	struct qdf_mac_addr remote = {0};
+	struct wlan_objmgr_peer *obj_peer, *self;
+	struct wma_pt_peer_state *slot = NULL;
+	struct wma_pt_peer_state snap;
+	target_resource_config *cfg;
+	enum wlan_phymode mlme_phymode;
+	u32 wmi_mode = WMI_HOST_MODE_11A;
+	unsigned long flags, deadline;
+	QDF_STATUS status;
+	u8 remote_copy[QDF_MAC_ADDR_SIZE];
+	u8 vdev_id;
+	int i, free_idx = -1, rc;
+
+	if (!generation || !wma || !wma->psoc || !wma->wmi_handle || !soc ||
+	    !wma_is_passthru_vdev(vdev) || !remote_mac || enable_reo > 2 ||
+	    !raw_caps)
+		return -EINVAL;
+
+	wma_pt_normalize_caps(&caps, raw_caps);
+
+	memcpy(remote.bytes, remote_mac, QDF_MAC_ADDR_SIZE);
+	memcpy(remote_copy, remote_mac, QDF_MAC_ADDR_SIZE);
+	if (qdf_is_macaddr_zero(&remote) || qdf_is_macaddr_group(&remote))
+		return -EINVAL;
+
+	vdev_id = wlan_vdev_get_id(vdev);
+	if (vdev_id >= wma->max_bssid ||
+	    !wmi_service_enabled(wma->wmi_handle, wmi_service_peer_create_conf) ||
+	    !wmi_service_enabled(wma->wmi_handle, wmi_service_sync_delete_cmds))
+		return -EINVAL;
+
+	cfg = lmac_get_tgt_res_cfg(wma->psoc);
+	self = wlan_vdev_get_bsspeer(vdev);
+	if (!cfg || cfg->num_peers <= 1 || !self ||
+	    wlan_peer_get_vdev(self) != vdev ||
+	    memcmp(wlan_peer_get_macaddr(self), wlan_vdev_mlme_get_macaddr(vdev),
+		   QDF_MAC_ADDR_SIZE) ||
+	    !memcmp(wlan_peer_get_macaddr(self), remote_copy, QDF_MAC_ADDR_SIZE))
+		return -EINVAL;
+
+	mutex_lock(&wma_pt_peer_ops_lock);
+	if (wma->interfaces[vdev_id].vdev != vdev ||
+	    wma->interfaces[vdev_id].peer_count < 1) {
+		rc = -EINVAL;
+		goto unlock_ops;
+	}
+	if (wma->interfaces[vdev_id].peer_count >= cfg->num_peers) {
+		rc = -ENOSPC;
+		goto unlock_ops;
+	}
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	for (i = 0; i < WMA_PT_MAX_PEERS; i++) {
+		struct wma_pt_peer_state *s = &wma_pt_peers[i];
+
+		if (s->peer_seq) {
+			if (!memcmp(s->mac, remote_copy, QDF_MAC_ADDR_SIZE)) {
+				if (s->generation == generation &&
+				    s->vdev_id == vdev_id && s->tx_ready &&
+				    !memcmp(&s->caps, &caps, sizeof(caps)))
+					rc = 0;
+				else
+					rc = -EBUSY;
+				spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+				goto unlock_ops;
+			}
+		} else if (free_idx < 0) {
+			free_idx = i;
+		}
+	}
+	if (free_idx < 0) {
+		spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+		rc = -ENOSPC;
+		goto unlock_ops;
+	}
+
+	slot = &wma_pt_peers[free_idx];
+	memset(slot, 0, sizeof(*slot));
+	if (++wma_pt_peer_seq == 0)
+		++wma_pt_peer_seq;
+	slot->peer_seq = wma_pt_peer_seq;
+	slot->slot_idx = free_idx;
+	slot->wma = wma;
+	slot->psoc = wma->psoc;
+	slot->generation = generation;
+	slot->vdev_id = vdev_id;
+	memcpy(slot->mac, remote_copy, QDF_MAC_ADDR_SIZE);
+	slot->active = true;
+	slot->reo_enabled = enable_reo;
+	slot->is_2ss = caps.nss >= 2;
+	slot->caps = caps;
+	slot->peer_id = U16_MAX;
+	slot->ast_idx = U16_MAX;
+	wma_pt_sync_fast_locked(slot);
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+
+	obj_peer = wma_create_objmgr_peer_typed(wma, vdev_id, remote_copy,
+						WMI_PEER_TYPE_DEFAULT, NULL,
+						WLAN_PEER_STA);
+	if (!obj_peer) {
+		rc = -ENOMEM;
+		goto fail_early;
+	}
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot->obj_created = true;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+
+	status = wlan_objmgr_peer_try_get_ref(obj_peer, WLAN_LEGACY_WMA_ID);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wlan_objmgr_peer_obj_delete(obj_peer);
+		rc = qdf_status_to_os_return(status);
+		goto fail_early;
+	}
+	status = cdp_peer_create(soc, vdev_id, remote_copy);
+	if (QDF_IS_STATUS_ERROR(status))
+		wlan_objmgr_peer_obj_delete(obj_peer);
+	wlan_objmgr_peer_release_ref(obj_peer, WLAN_LEGACY_WMA_ID);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		rc = qdf_status_to_os_return(status);
+		goto fail_early;
+	}
+
+	wma_increment_peer_count(wma, vdev_id);
+	cparam.vdev_id = vdev_id;
+	cparam.peer_addr = remote_copy;
+	cparam.peer_type = WMI_PEER_TYPE_DEFAULT;
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot->dp_created = true;
+	slot->create_issued = true;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+
+	status = wmi_unified_peer_create_send(wma->wmi_handle, &cparam);
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot->create_submit = status;
+	slot->create_returned = true;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		rc = qdf_status_to_os_return(status);
+		goto rollback;
+	}
+
+	deadline = jiffies + msecs_to_jiffies(WMA_PT_PEER_WAIT_MS);
+	rc = -ETIMEDOUT;
+	do {
+		if (cds_is_driver_recovering()) {
+			rc = -ESHUTDOWN;
+			break;
+		}
+		spin_lock_irqsave(&wma_pt_peer_lock, flags);
+		snap = *slot;
+		spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+		if (snap.dp_conflict) {
+			rc = -EIO;
+			break;
+		}
+		if (snap.create_confirmed) {
+			if (snap.create_status != 0) {
+				rc = -EPROTO;
+				break;
+			}
+			if (snap.htt_map && snap.slot_installed && snap.ast_valid) {
+				rc = 0;
+				break;
+			}
+		}
+		usleep_range(2000, 4000);
+	} while (time_before(jiffies, deadline));
+	if (rc)
+		goto rollback;
+
+	WRITE_ONCE(pt_reo_mode, enable_reo);
+	if (enable_reo) {
+		status = cdp_peer_setup(soc, vdev_id, remote_copy, NULL);
+		spin_lock_irqsave(&wma_pt_peer_lock, flags);
+		slot->reo_setup = true;
+		slot->reo_status = status;
+		spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+		if (QDF_IS_STATUS_ERROR(status)) {
+			rc = qdf_status_to_os_return(status);
+			goto rollback;
+		}
+	}
+
+	wma_pt_fill_assoc_params(&assoc, remote_copy, vdev_id, free_idx, &caps);
+	mlme_phymode = wma_pt_caps_phymodes(&caps, &wmi_mode);
+	wma_objmgr_set_peer_mlme_phymode(wma, assoc.peer_mac, mlme_phymode);
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot->assoc_issued = true;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+
+	status = wmi_unified_peer_assoc_send(wma->wmi_handle, &assoc);
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot->assoc_submit = status;
+	slot->assoc_returned = true;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		rc = qdf_status_to_os_return(status);
+		goto rollback;
+	}
+
+	deadline = jiffies + msecs_to_jiffies(WMA_PT_PEER_WAIT_MS);
+	rc = -ETIMEDOUT;
+	do {
+		if (cds_is_driver_recovering()) {
+			rc = -ESHUTDOWN;
+			break;
+		}
+		spin_lock_irqsave(&wma_pt_peer_lock, flags);
+		snap = *slot;
+		spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+		if (snap.dp_conflict) {
+			rc = -EIO;
+			break;
+		}
+		if (snap.assoc_confirmed) {
+			rc = snap.assoc_status ? -EPROTO : 0;
+			break;
+		}
+		usleep_range(2000, 4000);
+	} while (time_before(jiffies, deadline));
+	if (rc)
+		goto rollback;
+
+	if (pt_fw_addba) {
+		struct addba_send_params params = {
+			.vdev_id = vdev_id, .tidno = 0, .buffersize = 64,
+		};
+		status = wmi_unified_addba_send_cmd_send(wma->wmi_handle,
+						       remote_copy, &params);
+		pt_fw_addba_rc = qdf_status_to_os_return(status);
+		pt_fw_addba_sent = QDF_IS_STATUS_SUCCESS(status);
+	}
+	status = cdp_peer_state_update(soc, remote_copy, OL_TXRX_PEER_STATE_AUTH);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		rc = qdf_status_to_os_return(status);
+		goto rollback;
+	}
+
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot->setup_rc = 0;
+	wma_pt_set_tx_ready_locked(slot, true);
+	wma_pt_peer_last = *slot;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	mutex_unlock(&wma_pt_peer_ops_lock);
+	return 0;
+
+fail_early:
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot->setup_rc = rc;
+	wma_pt_clear_slot_locked(slot);
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	mutex_unlock(&wma_pt_peer_ops_lock);
+	return rc;
+
+rollback:
+	spin_lock_irqsave(&wma_pt_peer_lock, flags);
+	slot->setup_rc = rc;
+	spin_unlock_irqrestore(&wma_pt_peer_lock, flags);
+	(void)wma_pt_remote_peer_del_slot_locked(wma, vdev, slot);
+unlock_ops:
+	mutex_unlock(&wma_pt_peer_ops_lock);
+	return rc;
+}
