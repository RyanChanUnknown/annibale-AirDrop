+static int hdd_pt_shutdown_error;
+static int hdd_pt_remove_error;
+static DEFINE_MUTEX(hdd_pt_ssr_lock);
+static bool hdd_pt_ssr_transition_held;
+static struct device *hdd_pt_ssr_device;
+
