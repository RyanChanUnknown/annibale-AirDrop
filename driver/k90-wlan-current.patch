+/* Read-only proof for one imminent caller-owned request_put. The external
+ * coordinator has stopped WMI/scheduler producers and serializes parameter
+ * ownership; this snapshot does not itself acquire a new vdev reference.
+ */
+QDF_STATUS
+wma_passthru_recovery_request_guard(struct wlan_objmgr_vdev *vdev)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct scheduler_ctx *sched = scheduler_get_context();
+	struct wma_txrx_node *iface;
+	struct del_vdev_params *param;
+	uint8_t id;
+
+	if (!wma || !wma->interfaces || !wma->wmi_handle ||
+	    !wma_is_passthru_vdev(vdev))
+		return QDF_STATUS_E_INVAL;
+	if (!sched || sched->sch_thread || !wmi_is_blocked(wma->wmi_handle) ||
+	    READ_ONCE(wma->passthru_reap_vdev))
+		return QDF_STATUS_E_BUSY;
+	id = wlan_vdev_get_id(vdev);
+	if (id >= wma->max_bssid)
+		return QDF_STATUS_E_INVAL;
+	iface = &wma->interfaces[id];
+	param = iface->del_staself_req;
+	if (!iface->passthru_detach_blocked || iface->is_del_sta_deferred ||
+	    !param || param->vdev != vdev || param->vdev_id != id ||
+	    vdev->obj_state != WLAN_OBJ_STATE_LOGICALLY_DELETED)
+		return QDF_STATUS_E_BUSY;
+	return QDF_STATUS_SUCCESS;
+}
