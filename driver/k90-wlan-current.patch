+static inline QDF_STATUS
+__qdf_nbuf_get_radiotap_len_checked(struct sk_buff *skb, uint16_t *len)
+{
+	uint16_t value;
+
+	if (!skb || !len || skb_headlen(skb) < 8 || skb->data[0] != 0)
+		return QDF_STATUS_E_INVAL;
+	value = (uint16_t)skb->data[2] | ((uint16_t)skb->data[3] << 8);
