 /* An atomic flag to check if SSR cleanup has been done or not */
 static qdf_atomic_t is_recovery_cleanup_done;
+#ifdef DRIVER_PASSTHRU_RUNTIME
+/* Sticky after a partial shutdown. Reinit must not overwrite retained parents.
+ * This is not a recovery policy or permission to unload; caller still owns
