+/* Caller has stopped new WMI/scheduler/RX producers. Cancel joins the timer
+ * tail; it does NOT consume a pending response or clear its ownership bits.
+ */
+static QDF_STATUS
+wma_passthru_reap_timer_fence(tp_wma_handle wma, uint8_t id)
+{
+	struct wlan_lmac_if_mlme_rx_ops *ops;
+	struct vdev_response_timer *timer;
+
+	ops = target_if_vdev_mgr_get_rx_ops(wma->psoc);
+	if (!ops || !ops->psoc_get_vdev_response_timer_info)
+		return QDF_STATUS_E_INVAL;
+	timer = ops->psoc_get_vdev_response_timer_info(wma->psoc, id);
+	if (!timer || timer->psoc != wma->psoc || timer->vdev_id != id ||
+	    !qdf_atomic_read(&timer->rsp_timer_inuse))
+		return QDF_STATUS_E_INVAL;
+	qdf_timer_sync_cancel(&timer->rsp_timer);
+	return timer->rsp_status ? QDF_STATUS_E_BUSY : QDF_STATUS_SUCCESS;
+}
+
+/* The exact objmgr destructor, not a vdev-ID event, claims this handoff.
+ * State is in WMA (not iface): the legacy callback resets the whole iface.
+ */
+bool wma_passthru_recovery_delete_complete(struct wlan_objmgr_vdev *vdev)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct vdev_delete_response rsp = {0};
+	QDF_STATUS status;
+	bool same_task;
+
+	if (!wma || !vdev || READ_ONCE(wma->passthru_reap_vdev) != vdev)
+		return false;
+	if (atomic_cmpxchg(&wma->passthru_reap_state, WMA_PT_REAP_ARMED,
+			   WMA_PT_REAP_CLAIMED) != WMA_PT_REAP_ARMED)
+		return true; /* Already claimed; never fall back to another DELETE. */
+	same_task = READ_ONCE(wma->passthru_reap_task) == current;
+	rsp.vdev_id = wlan_vdev_get_id(vdev);
+	status = wma_vdev_detach_callback(&rsp);
+	qdf_atomic_set(&wma->passthru_reap_state,
+		       same_task && !QDF_IS_STATUS_ERROR(status) ?
+		       WMA_PT_REAP_SYNC_DONE : WMA_PT_REAP_DEFERRED);
+	return true;
+}
